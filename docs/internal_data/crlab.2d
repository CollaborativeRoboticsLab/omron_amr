LogInfoStrip: CustomInfo: ConfigParam "Name=CentralStandbyPacketIn" "Parent=Internal Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables logging for AramCentralStandby that shows CMD packet receipts and contents." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CentralStandbyPacketOut" "Parent=Internal Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables logging for AramCentralStandby that shows return packet contents before sending." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CentralStandbyHelpers" "Parent=Internal Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra logging for AramCentralStandby that shows standbyHelper claims changes." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CentralStandbyVerboseLogs" "Parent=Internal Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra verbose logging for AramCentralStandby that shows standbyHelper claims log dumps." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CentralStandbyClosestStandby" "Parent=Internal Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra verbose logging for AramCentralStandby that shows the map object search process for the closest Standby." "Value=false"   "Display=Checkbox" 
