LogInfoStrip: TaskInfo: TaskDesc "Name=sendSound" "Desc=Send sound from a robot sound file to all clients, and continue when it's done." "Class=ClientAudio"
LogInfoStrip: TaskInfo: ArgDesc "Name=sound file name" "Parent=sendSound" "Priority=Normal" "Type=string" "Desc=Sound file (must be uncompressed WAV format, 16khz sample rate or higher) previously uploaded to the robot, (Special Codes: $g=goal name. Current robot position $X (x in mm) $Y (y in mm) $T (heading in degrees, -180 to 180). Time in GMT: $y=current year, $m=month, $d=day, $H=hour, $M=minute, $S=second.)" "Value="   "Display=RobotFile:WAV Files (*.wav)|*.wav" 
