LogInfoStrip: TaskInfo: TaskDesc "Name=moveProx" "Desc=Move forward by the specified distance, stopping if proximity sensors are triggered.  The stopping criteria can be based on all proximity sensors, or any proximity sensor." "Class=Movement"
LogInfoStrip: TaskInfo: ArgDesc "Name=proxUseProx" "Parent=moveProx" "Priority=Normal" "Type=bool" "Desc=Stop the robot if the specified proximity sensors are triggered. Recommend enabling (true)." "Value=true"  
LogInfoStrip: TaskInfo: ArgDesc "Name=proxCheckType" "Parent=moveProx" "Priority=Detailed" "Type=string" "Desc=Set of proximity sensors that must be triggered (or not triggered) to stop the move." "Value=AnyTriggered"   "Display=Choices:AllTriggered;;AnyTriggered;;AnyNotTriggered;;AllNotTriggered" 
LogInfoStrip: TaskInfo: ArgDesc "Name=proxUseQuickStop" "Parent=moveProx" "Priority=Normal" "Type=bool" "Desc=Use a quickstop when the proximity sensor or input triggers.  The quickstop is similar to an E-stop, except that it uses the brakes when available and it does not latch." "Value=true"  
LogInfoStrip: TaskInfo: ArgDesc "Name=proxCheckInterval" "Parent=moveProx" "Priority=Detailed" "Type=string" "Desc=Frequence (in ms) to check the proximity sensors. Time is approximate and platform-dependent. (On some systems, a frequency set to 1 ms may result in checking the sensors every 10 ms, for example.) 0 means that the sensors should be checked as fast as possible and may have an adverse effect on localization." "Value=10ms"   "Display=Choices:0ms;;1ms;;10ms;;20ms;;cycle" 
LogInfoStrip: TaskInfo: ArgDesc "Name=distance" "Parent=moveProx" "Priority=Important" "Type=int" "Desc=Distance (in mm) to move forward from the current location." "Value=1000"  
LogInfoStrip: TaskInfo: ArgDesc "Name=speed" "Parent=moveProx" "Priority=Normal" "Type=int" "Desc=Speed (in mm/sec) at which to move." "Value=400" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=front clearance" "Parent=moveProx" "Priority=Detailed" "Type=int" "Desc=Distance (in mm) to maintain between the front of the robot and any obstacles." "Value=200"  
LogInfoStrip: TaskInfo: ArgDesc "Name=side clearance" "Parent=moveProx" "Priority=Detailed" "Type=int" "Desc=Distance (in mm) to maintain between the side of the robot and any obstacles." "Value=50"  
LogInfoStrip: TaskInfo: ArgDesc "Name=time until fail" "Parent=moveProx" "Priority=Detailed" "Type=int" "Desc=Duration (in sec) to wait for an obstacle to clear before declaring that the move has failed." "Value=30" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=transAccel" "Parent=moveProx" "Priority=Detailed" "Type=int" "Desc=Acceleration (in mm/sec/sec) for the move. 0 means use the robot's default acceleration." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=transDecel" "Parent=moveProx" "Priority=Detailed" "Type=int" "Desc=Deceleration (in mm/sec/sec) for the move. 0 means use the robot's default acceleration." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=minimum time" "Parent=moveProx" "Priority=Detailed" "Type=int" "Desc=Minimum duration (in sec) of this task. If the robot reaches the destination in less time, the task waits for the remainder of the duration. 0 means that task should complete as soon as the robot reaches the destination." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=AvoidLocationDependentObstacles" "Parent=moveProx" "Priority=Detailed" "Type=bool" "Desc=When enabled (true), the robot avoids location-dependent obstacles like forbidden lines and other robots. If this is disabled, then physical guards must be used to contain the robot." "Value=true"  
LogInfoStrip: TaskInfo: ArgDesc "Name=always succeed" "Parent=moveProx" "Priority=Detailed" "Type=bool" "Desc=Return success regardless of the distance moved. When enabled, the tasks will report success even if the destination is not reached. When disabled, the task fails if the destination is not reached." "Value=false"  
LogInfoStrip: TaskInfo: ArgDesc "Name=finish if stopped" "Parent=moveProx" "Priority=Detailed" "Type=bool" "Desc=Finish the task if the robot cannot move after the first two seconds. When enabled, the task finishes as soon as the robot cannot move. When disabled, the robot must be blocked for the specified 'time until fail' before the task is finished." "Value=true"  
LogInfoStrip: TaskInfo: TaskDesc "Name=jobTypeCheck" "Desc=Specify a different macro depending on whether a goal is a pickup, dropoff or neither."
LogInfoStrip: TaskInfo: ArgDesc "Name=none" "Parent=jobTypeCheck" "Priority=Normal" "Type=string" "Desc=Macro to execute when the task is not part of a pickup or dropoff job.  Optional." "Value="   "Display=Macro" 
LogInfoStrip: TaskInfo: ArgDesc "Name=pickup" "Parent=jobTypeCheck" "Priority=Normal" "Type=string" "Desc=Macro to execute when the job segment is a pickup.  Optional." "Value="   "Display=Macro" 
LogInfoStrip: TaskInfo: ArgDesc "Name=dropoff" "Parent=jobTypeCheck" "Priority=Normal" "Type=string" "Desc=Macro to execute when the job segment is a dropoff.  Optional." "Value="   "Display=Macro" 
LogInfoStrip: TaskInfo: TaskDesc "Name=ARCLSendText" "Desc=Sends the given text on the ARCL server." "Class=ARCL|Instant"
LogInfoStrip: TaskInfo: ArgDesc "Name=String to send" "Parent=ARCLSendText" "Priority=Important" "Type=string" "Desc=Text to send to the ARCL server." "Value="  
LogInfoStrip: TaskInfo: TaskDesc "Name=SendText" "Desc=Sends the specified text to all clients" "Class=Instant"
LogInfoStrip: TaskInfo: ArgDesc "Name=key" "Parent=SendText" "Priority=Important" "Type=string" "Desc=Text identifier for the message" "Value="   "Display=RegExp:^[\w \u2000-\u206F\u2E00-\u2E7F\'!"#$%&()*+,\-.\/:;<=>?@\[\]^_`{|}~]{0,250}$" 
LogInfoStrip: TaskInfo: ArgDesc "Name=message" "Parent=SendText" "Priority=Important" "Type=string" "Desc=The text to send" "Value="   "Display=RegExp:^[\w \u2000-\u206F\u2E00-\u2E7F\'!"#$%&()*+,\-.\/:;<=>?@\[\]^_`{|}~]{0,250}$" 
LogInfoStrip: TaskInfo: TaskDesc "Name=arbitraryServerSend" "Desc=Sends the given text to a specified server and port." "Class=ExternalConnect"
LogInfoStrip: TaskInfo: ArgDesc "Name=Server hostname" "Parent=arbitraryServerSend" "Priority=Important" "Type=string" "Desc=Hostname of the server." "Value="  
LogInfoStrip: TaskInfo: ArgDesc "Name=Server port" "Parent=arbitraryServerSend" "Priority=Important" "Type=int" "Desc=Port number." "Value=0" "Max=65536" 
LogInfoStrip: TaskInfo: ArgDesc "Name=String to send" "Parent=arbitraryServerSend" "Priority=Important" "Type=string" "Desc=Text to send to the server. Escape sequences (\n, \r, \t, \\, and \<octalNumber>) are permitted. In addition, the following special sequences result in a substitution:  $g=goal name; time in GMT: $y=current year, $m=month, $d=day, $H=hour, $M=minute, $S=second; and $$ = $." "Value="  
LogInfoStrip: TaskInfo: TaskDesc "Name=triangleDriveTo" "Desc=Drives to the triangle, stopping a specified distance in front of it. The 'Triangle Drive To' parameters in the Robot Configuration apply to instances of this task." "Class=Movement"
LogInfoStrip: TaskInfo: ArgDesc "Name=frontBackOffset" "Parent=triangleDriveTo" "Priority=Detailed" "Type=int" "Desc=Distance (in mm) to offset the vertex in the front/back direction (+ in front of the triangle, - behind the triangle)." "Value=0"  
LogInfoStrip: TaskInfo: ArgDesc "Name=rightLeftOffset" "Parent=triangleDriveTo" "Priority=Detailed" "Type=int" "Desc=Distance (in mm) to offset the vertex in the right/left direction (- to the right of the triangle, + to the left of the triangle)." "Value=0"  
LogInfoStrip: TaskInfo: ArgDesc "Name=angleOffset" "Parent=triangleDriveTo" "Priority=Detailed" "Type=double" "Desc=Angle (in deg) to offset the vertex (+ to the left of the triangle, - to the right of the triangle)." "Value=0"  
LogInfoStrip: TaskInfo: TaskDesc "Name=trianglePointAway" "Desc=Turns away from the most recent triangleDriveTo destination." "Class=Movement|Heading"
LogInfoStrip: TaskInfo: ArgDesc "Name=rotVelMax" "Parent=trianglePointAway" "Priority=Detailed" "Type=int" "Desc=Maximum rotational velocity (in deg/sec) when turning. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=rotAccel" "Parent=trianglePointAway" "Priority=Detailed" "Type=int" "Desc=Rotational acceleration (in deg/sec/sec) when turning. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=rotDecel" "Parent=trianglePointAway" "Priority=Detailed" "Type=int" "Desc=Rotational deceleration (in deg/sec/sec) when turning. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=time until fail" "Parent=trianglePointAway" "Priority=Detailed" "Type=int" "Desc=Duration (in sec) to wait if unable to turn before declaring that the task has failed." "Value=30" "Min=0" 
LogInfoStrip: TaskInfo: TaskDesc "Name=triangleDriveToAdvanced" "Desc=Drives to the triangle, stopping a specified distance in front of it. This task allows all of the normal triangle driving parameters to be overridden." "Class=Movement"
LogInfoStrip: TaskInfo: ArgDesc "Name=frontBackOffset" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=double" "Desc=Distance (in mm) to offset the vertex in the front/back direction (+ in front of the triangle, - behind the triangle)." "Value=0"  
LogInfoStrip: TaskInfo: ArgDesc "Name=rightLeftOffset" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=double" "Desc=Distance (in mm) to offset the vertex in the right/left direction (- to the right of the triangle, + to the left of the triangle)." "Value=0"  
LogInfoStrip: TaskInfo: ArgDesc "Name=angleOffset" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=double" "Desc=Angle (in deg) to offset the vertex (+ to the left of the triangle, - to the right of the triangle)." "Value=0"  
LogInfoStrip: TaskInfo: ArgDesc "Name=FinalDistFromVertex" "Parent=triangleDriveToAdvanced" "Priority=Normal" "Type=double" "Desc=Distance (in mm) from the triangle vertex to the final stopping point of the center of the robot. 0 means drive until a bump or stall is triggered." "Value=500" "Max=2000" 
LogInfoStrip: TaskInfo: ArgDesc "Name=ApproachDistFromVertex" "Parent=triangleDriveToAdvanced" "Priority=Normal" "Type=double" "Desc=Distance (in mm) from the vertex to the initial approach point for the center of the robot." "Value=750" "Max=2500" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FailTime" "Parent=triangleDriveToAdvanced" "Priority=Normal" "Type=int" "Desc=Maximum duration (in sec) to try to drive to the triangle. If the robot does not succeed during this timeframe, the task fails." "Value=45" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleDriveSpeed" "Parent=triangleDriveToAdvanced" "Priority=Normal" "Type=double" "Desc=Speed (in mm/sec) to drive durin g the initial approach." "Value=100" "Max=500" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleDriveTolerance" "Parent=triangleDriveToAdvanced" "Priority=Normal" "Type=double" "Desc=Threshold (in mm)  that indicates how close to drive to the point." "Value=25" "Max=200" 
LogInfoStrip: TaskInfo: ArgDesc "Name=Line1Length" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=double" "Desc=Length (in mm) of the first line of the triangle. 0 matches any line length." "Value=254" "Max=1000" 
LogInfoStrip: TaskInfo: ArgDesc "Name=AngleBetweenLines" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=double" "Desc=Angle (in deg) between the two triangle lines. 0 matches any angle." "Value=135" "Max=180" 
LogInfoStrip: TaskInfo: ArgDesc "Name=Line2Length" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=double" "Desc=Length (in mm) of the second line of the triangle. 0 matches any line length." "Value=254" "Max=1000" 
LogInfoStrip: TaskInfo: ArgDesc "Name=MaxDistBetweenLinePoints" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=int" "Desc=Maximum distance (in mm) between points that are turned into lines. This may be used to eliminate points when a laser sees both part of the target triangle and part of the background. 0 disables this feature." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=MaxLateralDist" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=int" "Desc=Maximum distance (in mm) to the left or right that the robot will look for a vertex.  (Technically, the maximum distance between the robot's center and an imaginary line projected from the vertex).  Any potential vertex outside this range is ignored. 0 disables this feature." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=MaxAngleMisalignment" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=int" "Desc=Maximum difference (in deg) allowed between the robot's heading and the angle of the vertex line. Any vertex line outside this range ignored. 0 disables this feature." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleFrontClearance" "Parent=triangleDriveToAdvanced" "Priority=Normal" "Type=double" "Desc=Front clearance (in mm) when driving to a triangle. If an obstacle is detected in this area, the robot stops. This value should be large enough to allow the robot to plan a path away from the triangle." "Value=100"  
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleSideClearance" "Parent=triangleDriveToAdvanced" "Priority=Normal" "Type=double" "Desc=Side clearance (in mm) when driving to a triangle. If an obstacle is detected in this area, the robot stops. This value should be large enough to allow the robot to plan a path away from the triangle." "Value=100"  
LogInfoStrip: TaskInfo: ArgDesc "Name=AvoidLocationDependentObstacles" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=bool" "Desc=When enabled (true), the robot avoids location-dependent obstacles like forbidden lines and other robots when driving to the triangle. If this is disabled, then physical guards must be used to contain the robot whenever this task is used." "Value=true"  
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleAdjustVertex" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=bool" "Desc=Use an alternate calculation for the vertex." "Value=false"  
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleGotoVertex" "Parent=triangleDriveToAdvanced" "Priority=Normal" "Type=bool" "Desc=Drive to the vertex instead of the point in front of it." "Value=false"  
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleIgnoreDist" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=double" "Desc=Distance (in mm) from the final point at which the robot starts ignoring the triangle and drives solely based on its last reading. When the triangle is black, this value should be set since the robot has the potential to lose a black target when it is too close. (In this case, the default value is 0 when TriangleGoToVertex is true and is 250 when TriangleGoToVertex is false.)  0 is likely acceptable for triangles that are not black." "Value=250"  
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleBackDist" "Parent=triangleDriveToAdvanced" "Priority=Normal" "Type=int" "Desc=Distance (in mm) that the robot should back up after reaching the triangle point." "Value=0" "Max=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleLogMore" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=bool" "Desc=Log additional information about triangle driving." "Value=false"  
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleTransVelMax" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=double" "Desc=Maximum forward translational velocity (in mm/sec) when driving to the triangle. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleTransNegVelMax" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=double" "Desc=Maximum backward translational velocity (in mm/sec) when driving to the triangle. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleTransAccel" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=double" "Desc=Translational acceleration (in mm/sec/sec) when driving to the triangle. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleTransDecel" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=double" "Desc=Translational deceleration (in mm/sec/sec) when driving to the triangle. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleRotVelMax" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=double" "Desc=Maximum rotational velocity (in deg/sec) when driving to the triangle. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleRotAccel" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=double" "Desc=Rotational acceleration (in deg/sec/sec) when driving to the triangle. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TriangleRotDecel" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=double" "Desc=Rotational deceleration (in deg/sec/sec) when driving to the triangle. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=StopOnProx" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=bool" "Desc=Stop the robot if any of the proximity sensors are triggered when driving to the triangle. Recommend enabling (true)." "Value=true"  
LogInfoStrip: TaskInfo: ArgDesc "Name=UseQuickStop" "Parent=triangleDriveToAdvanced" "Priority=Detailed" "Type=bool" "Desc=Use a quickstop when the proximity sensor or input triggers when driving to the triangle.  The quickstop is similar to an E-stop, except that it uses the brakes when available and it does not latch." "Value=false"  
LogInfoStrip: TaskInfo: TaskDesc "Name=trianglePointAwayAdvanced" "Desc=Turns away from the most recent triangleDriveToAdvanced destination." "Class=Movement|Heading"
LogInfoStrip: TaskInfo: ArgDesc "Name=rotVelMax" "Parent=trianglePointAwayAdvanced" "Priority=Detailed" "Type=int" "Desc=Maximum rotational velocity (in deg/sec) when turning. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=rotAccel" "Parent=trianglePointAwayAdvanced" "Priority=Detailed" "Type=int" "Desc=Rotational acceleration (in deg/sec/sec) when turning. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=rotDecel" "Parent=trianglePointAwayAdvanced" "Priority=Detailed" "Type=int" "Desc=Rotational deceleration (in deg/sec/sec) when turning. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=time until fail" "Parent=trianglePointAwayAdvanced" "Priority=Detailed" "Type=int" "Desc=Duration (in sec) to wait if unable to turn before declaring that the task has failed." "Value=30" "Min=0" 
LogInfoStrip: TaskInfo: TaskDesc "Name=PrecisionDrive" "Desc=Drives the AMR to a location relative to a specified target" "Class=Movement"
LogInfoStrip: TaskInfo: ArgDesc "Name=TargetShape" "Parent=PrecisionDrive" "Priority=Important" "Type=string" "Desc=Specifies the target shape matched by the AMR’s range sensor data" "Value=Standard"   "Display=Choices:StandardCopy;;StandardReverseCopy;;SimpleOpenTarget;;Standard;;StandardReverse;;DockLD;;DockHD" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FinalOffsetX" "Parent=PrecisionDrive" "Priority=Important" "Type=double" "Desc=Final axial distance in mm from the target center to the AMR center in the coordinate system of the specified target" "Value=-1000" "Max=4000" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FinalOffsetY" "Parent=PrecisionDrive" "Priority=Normal" "Type=double" "Desc=Final lateral distance in mm from the target center to the AMR center in the coordinate system of the specified target" "Value=0" "Max=4000" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FinalOffsetAngle" "Parent=PrecisionDrive" "Priority=Normal" "Type=double" "Desc=Final rotation in degrees from the target center to the AMR center in the coordinate system of the specified target" "Value=0" "Max=200" 
LogInfoStrip: TaskInfo: ArgDesc "Name=InitialX" "Parent=PrecisionDrive" "Priority=Important" "Type=double" "Desc=Initial axial distance in mm from the target center to the AMR center in the coordinate system of the specified target" "Value=-2000" "Max=4000" 
LogInfoStrip: TaskInfo: ArgDesc "Name=InitialY" "Parent=PrecisionDrive" "Priority=Normal" "Type=double" "Desc=Initial lateral distance in mm from the target center to the AMR center in the coordinate system of the specified target" "Value=0" "Max=4000" 
LogInfoStrip: TaskInfo: ArgDesc "Name=InitialAngle" "Parent=PrecisionDrive" "Priority=Normal" "Type=double" "Desc=Initial rotation in degrees from the target center to the AMR center in the coordinate system of the specified target" "Value=0" "Max=180" 
LogInfoStrip: TaskInfo: ArgDesc "Name=ParameterMode" "Parent=PrecisionDrive" "Priority=Detailed" "Type=string" "Desc=Toggles visibility of advanced parameters" "Value=Normal"   "Display=Choices:Normal;;Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=Timeout" "Parent=PrecisionDrive" "Priority=Detailed" "Type=int" "Desc=Elapsed time in seconds from task start before failing" "Value=60" "Max=54000"  "Display=Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=PathShape" "Parent=PrecisionDrive" "Priority=Detailed" "Type=string" "Desc=Specifies the path shape the AMR follows to the final location" "Value=PreAlign"   "Display=Choices:PreAlign;;Straight;;PreAlign2&&Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=SearchMode" "Parent=PrecisionDrive" "Priority=Detailed" "Type=string" "Desc=Specifies the size of search area surrounding the Initial location to look for the target" "Value=Normal"   "Display=Choices:Normal;;Wide;;Tall;;Minimum;;Maximum;;Rotation&&Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=MatchMode" "Parent=PrecisionDrive" "Priority=Detailed" "Type=string" "Desc=Specifies the allowable deviation between the ideal target shape and the detected shape" "Value=Normal"   "Display=Choices:Normal;;Lenient;;Strict&&Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FailMode" "Parent=PrecisionDrive" "Priority=Detailed" "Type=string" "Desc=Specifies the abnormal conditions that cause the task to fail immediately" "Value=None"   "Display=Choices:None;;FailOnEstop&&Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=DebugMode" "Parent=PrecisionDrive" "Priority=Detailed" "Type=string" "Desc=Specifies what task information is logged for debugging purposes" "Value=Normal"   "Display=Visible:ParameterMode=Advanced&&Choices:None;;Normal;;Moderate;;Extensive;;All" 
LogInfoStrip: TaskInfo: ArgDesc "Name=ClearanceMode" "Parent=PrecisionDrive" "Priority=Detailed" "Type=string" "Desc=Specifies the area around the AMR for obstacle protection while moving to the final location" "Value=Normal"   "Display=Visible:ParameterMode=Advanced&&Choices:Normal;;Variable;;Custom" 
LogInfoStrip: TaskInfo: ArgDesc "Name=ApproachDistance" "Parent=PrecisionDrive" "Priority=Detailed" "Type=double" "Desc=Specifies the minimum distance in mm that the AMR should stop when approaching an obstacle" "Value=1000" "Max=8000"  "Display=Visible:ClearanceMode!=Normal" 
LogInfoStrip: TaskInfo: ArgDesc "Name=VirtualObstaclesAreReal" "Parent=PrecisionDrive" "Priority=Detailed" "Type=bool" "Desc=Treat virtual obstacles (Forbidden Area, etc) as real obstacles" "Value=true"   "Display=Checkbox&&Visible:false" 
LogInfoStrip: TaskInfo: ArgDesc "Name=ClearanceShape" "Parent=PrecisionDrive" "Priority=Detailed" "Type=string" "Desc=Specifies the footprint shape of the AMR for obstacle protection" "Value=Normal"   "Display=Choices:Normal;;Tight;;Expanded;;Custom&&Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FrontClearance" "Parent=PrecisionDrive" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the front clearance zone from the front edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:ClearanceShape=Custom&&Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=LeftClearance" "Parent=PrecisionDrive" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the left side clearance zone from the left edge of the AMR." "Value=75" "Max=1000"  "Display=Visible:ClearanceShape=Custom&&Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=RightClearance" "Parent=PrecisionDrive" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the right side clearance zone from the right edge of the AMR." "Value=75" "Max=1000"  "Display=Visible:ClearanceShape=Custom&&Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=BackClearance" "Parent=PrecisionDrive" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the back side clearance zone from the back edge of the AMR." "Value=20" "Max=1000"  "Display=Visible:ClearanceShape=Custom&&Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=ClearanceSwitchDistance" "Parent=PrecisionDrive" "Priority=Detailed" "Type=double" "Desc=Specifies the distance in mm from the desired final position that the AMR will switch to using the defined Internal Clearances" "Value=300" "Max=3000"  "Display=Visible:ClearanceMode=Variable&&Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FinalClearanceShape" "Parent=PrecisionDrive" "Priority=Detailed" "Type=string" "Desc=Specifies the footprint shape of the AMR for obstacle protection during the final motion" "Value=Normal"   "Display=Choices:Normal;;Tight;;Expanded;;Custom&&Visible:ClearanceMode=Variable&&Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FinalFrontClearance" "Parent=PrecisionDrive" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the front clearance zone from the front edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:ClearanceMode=Variable&&Visible:FinalClearanceShape=Custom" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FinalLeftClearance" "Parent=PrecisionDrive" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the left side clearance zone from the left edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:ClearanceMode=Variable&&Visible:FinalClearanceShape=Custom" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FinalRightClearance" "Parent=PrecisionDrive" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the right side clearance zone from the right edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:ClearanceMode=Variable&&Visible:FinalClearanceShape=Custom" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FinalBackClearance" "Parent=PrecisionDrive" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the back side clearance zone from the back edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:ClearanceMode=Variable&&Visible:FinalClearanceShape=Custom" 
LogInfoStrip: TaskInfo: ArgDesc "Name=DriveMode" "Parent=PrecisionDrive" "Priority=Detailed" "Type=string" "Desc=Specifies how the driving motion is optimized" "Value=Normal"   "Display=Visible:ParameterMode=Advanced&&Choices:Normal;;Smooth;;Precise;;Fast" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TranslationalSpeed" "Parent=PrecisionDrive" "Priority=Detailed" "Type=double" "Desc=Translational speed limit in mm/s" "Value=100" "Max=500"  "Display=Visible:ParameterMode=Advanced&&" 
LogInfoStrip: TaskInfo: ArgDesc "Name=ForwardSpeed" "Parent=PrecisionDrive" "Priority=Detailed" "Type=double" "Desc=Forward translational speed limit in mm/s" "Value=100" "Max=500"  "Display=Visible:false" 
LogInfoStrip: TaskInfo: ArgDesc "Name=ReverseSpeed" "Parent=PrecisionDrive" "Priority=Detailed" "Type=double" "Desc=Reverse translational speed limit in mm/s" "Value=-100" "Max=-50"  "Display=Visible:false" 
LogInfoStrip: TaskInfo: ArgDesc "Name=RotationalSpeed" "Parent=PrecisionDrive" "Priority=Detailed" "Type=double" "Desc=Rotational speed limit in deg/s" "Value=30" "Max=50"  "Display=Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=PrimaryLaser" "Parent=PrecisionDrive" "Priority=Detailed" "Type=string" "Desc=Specifies the laser number on the AMR for finding the target." "Value=Laser_1"   "Display=Choices:Laser_1;;Laser_2;;Laser_3;;Laser_4;;Laser_5;;Laser_6&&Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=IgnoreDistance" "Parent=PrecisionDrive" "Priority=Normal" "Type=double" "Desc=Specifies the distance in mm from the desired position that the AMR will not consider matching the target." "Value=0" "Max=10000"  "Display=Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=IgnoreFinalHeading" "Parent=PrecisionDrive" "Priority=Normal" "Type=bool" "Desc=" "Value=false"   "Display=Checkbox&&Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TaskRequiresCAPS" "Parent=PrecisionDrive" "Priority=Normal" "Type=bool" "Desc=Enabling this parameter will verify that an AMR has a valid CAPS license installed prior to executing a PrecisionDrive task. The PrecisionDrive task will fail if a CAPS license is not installed on the AMR." "Value=false"   "Display=Checkbox&&Visible:ParameterMode=Advanced" 
LogInfoStrip: TaskInfo: TaskDesc "Name=CalibrateMainLaser" "Desc=Calibrates Main Laser Theta" "Class=Movement"
LogInfoStrip: TaskInfo: ArgDesc "Name=LeftSideMeasurement" "Parent=CalibrateMainLaser" "Priority=Detailed" "Type=double" "Desc=Left Measured Offset from Target" "Value=1000"  
LogInfoStrip: TaskInfo: ArgDesc "Name=RightSideMeasurement" "Parent=CalibrateMainLaser" "Priority=Detailed" "Type=double" "Desc=Right Measured Offset from Target" "Value=1000"  
LogInfoStrip: TaskInfo: ArgDesc "Name=SamplingTime" "Parent=CalibrateMainLaser" "Priority=Detailed" "Type=int" "Desc=Time to sample for calibration measurement" "Value=30" "Max=180" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TargetShape" "Parent=CalibrateMainLaser" "Priority=Important" "Type=string" "Desc=Specifies which target shape is referenced during task" "Value=Standard"   "Display=Choices:Standard;;StandardReverse" 
LogInfoStrip: TaskInfo: ArgDesc "Name=InitialX" "Parent=CalibrateMainLaser" "Priority=Important" "Type=double" "Desc=" "Value=-2000" "Max=4000" 
LogInfoStrip: TaskInfo: ArgDesc "Name=InitialY" "Parent=CalibrateMainLaser" "Priority=Normal" "Type=double" "Desc=" "Value=0" "Max=4000" 
LogInfoStrip: TaskInfo: ArgDesc "Name=InitialAngle" "Parent=CalibrateMainLaser" "Priority=Normal" "Type=double" "Desc=" "Value=0" "Max=180" 
LogInfoStrip: TaskInfo: ArgDesc "Name=SearchMode" "Parent=CalibrateMainLaser" "Priority=Detailed" "Type=string" "Desc=" "Value=Normal"   "Display=Choices:Normal;;Wide;;Tall;;Minimum;;Maximum;;Rotation&&" 
LogInfoStrip: TaskInfo: ArgDesc "Name=MatchMode" "Parent=CalibrateMainLaser" "Priority=Detailed" "Type=string" "Desc=" "Value=Normal"   "Display=Choices:Normal;;Lenient;;Strict&&" 
LogInfoStrip: TaskInfo: ArgDesc "Name=DebugMode" "Parent=CalibrateMainLaser" "Priority=Detailed" "Type=string" "Desc=" "Value=Normal"   "Display=Choices:None;;Normal;;Moderate;;Extensive;;All" 
LogInfoStrip: TaskInfo: TaskDesc "Name=play" "Desc=Play a sound file, and wait until it finishes playing" "Class=RobotAudio"
LogInfoStrip: TaskInfo: ArgDesc "Name=sound file name" "Parent=play" "Priority=Normal" "Type=string" "Desc=Sound file (mp3, ogg, or wav previously uploaded to the robot). (Special Codes: $g=goal name. Current robot position $X (x in mm) $Y (y in mm) $T (heading in degrees, -180 to 180). Time in GMT: $y=current year, $m=month, $d=day, $H=hour, $M=minute, $S=second.)" "Value="   "Display=RobotFile:All sound files (*.mp3 *.ogg *.wav);;MP3 files (*.mp3);;Ogg Vorbis files (*.ogg);;WAV Files (*.wav)|*.ogg *.wav *.mp3;;*.mp3;;*.ogg;;*.wav" 
