LogInfoStrip: CustomInfo: ConfigParam "Name=LaserAutoBaudChoice" "Parent=Laser_3" "Priority=Expert" "Type=string" "Desc=AutoBaud for this laser. Leave blank to use the default." "Value="   "Display=Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserIsLow" "Parent=Laser_3" "Priority=Expert" "Type=bool" "Desc=If this laser is a low laser for sensing low obstacles (like feet, pallets, etc)." "Value=false"   "Display=Checkbox&&Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserIsForCartSensing" "Parent=Laser_3" "Priority=Expert" "Type=bool" "Desc=If this laser is the one mounted in the top deck for sensing the cart.  This laser is ignored by path planning." "Value=false"   "Display=Checkbox&&Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserIsTilted" "Parent=Laser_3" "Priority=Expert" "Type=bool" "Desc=The laser is tilted for sensing positive obstacles, i.e. ones above the ground." "Value=true"   "Display=Checkbox&&Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=TiltedFlipped" "Parent=Laser_3" "Priority=Expert" "Type=bool" "Desc=Flip the raw readings from the tilted laser upside-down. Applicable only when LaserIsTilted or LaserIsTiltedNegativeSensor." "Value=false"   "Display=Checkbox&&Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserIsTiltedNegativeSensor" "Parent=Laser_3" "Priority=Expert" "Type=bool" "Desc=Tilted lasers can be used as a secondary protection method against robots encountering negative obstacles (loading docks, stairs, etc.). This detection is only possible in the sensing plane of the tilted laser and cannot be used as the sole means of negative obstacle avoidance. Other primary protection methods should always be used. Talk to your robot provider before using this feature. This is still an experimental beta feature." "Value=false"   "Display=Checkbox&&Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserIsFiltered" "Parent=Laser_3" "Priority=Expert" "Type=bool" "Desc=Readings from the laser must be filtered. This may need to be enabled when the laser can detect the robot's casters (for example). If LaserIsTilted or LaserIsTiltedNegativeSensor is enabled, then this option is disregarded." "Value=false"   "Display=Checkbox&&Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserIsFiltered_v2" "Parent=Laser_3" "Priority=Expert" "Type=bool" "Desc=Readings from the laser must be filtered with the version 2 filter that works even when LaserIsTilted or LaserIsTiltedNegativeSensor is enabled. Like the original LaserIsFiltered parameter, this may need to be enabled when the laser can detect the robot's casters (for example). When enabled, this overrides the LaserIsFiltered value." "Value=true"   "Display=Checkbox&&Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigSection "Name=Laser_4"
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserAutoConnect" "Parent=Laser_4" "Priority=Expert" "Type=bool" "Desc=Laser_4 exists and should be automatically connected at startup." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=" "Parent=Laser_4" "Priority=Factory" "Type=unknown" "Desc="   
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserX" "Parent=Laser_4" "Priority=Expert" "Type=int" "Desc=Location (in mm) of the laser in X (+ front, - back) relative to the robot's idealized center of rotation." "Value=0"   "Display=Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserY" "Parent=Laser_4" "Priority=Expert" "Type=int" "Desc=Location (in mm) of the laser in Y (+ left, - right) relative to the robot's idealized center of rotation." "Value=0"   "Display=Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserTh" "Parent=Laser_4" "Priority=Expert" "Type=double" "Desc=Rotation (in deg) of the laser (+ counterclockwise, - clockwise)." "Value=0" "Max=180"  "Display=Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserZ" "Parent=Laser_4" "Priority=Expert" "Type=int" "Desc=Height (in mm) of the laser from the ground. 0 means unknown." "Value=0" "Min=0"  "Display=Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserIgnore" "Parent=Laser_4" "Priority=Expert" "Type=string" "Desc=Angles (in deg) at which to ignore readings, +/1 one degree. Angles are entered as strings, separated by a space." "Value=-120:-180,120:180"   "Display=Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserFlipped" "Parent=Laser_4" "Priority=Expert" "Type=bool" "Desc=Laser_4 is upside-down." "Value=true"   "Display=Visible:LaserAutoConnect=true&&Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserType" "Parent=Laser_4" "Priority=Expert" "Type=string" "Desc=Type of laser." "Value=tim3XX"   "Display=Visible:LaserAutoConnect=true&&Choices:s3series;;tim3XX;;tim510;;tim551;;os32c;;os32cethernet" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserPortType" "Parent=Laser_4" "Priority=Expert" "Type=string" "Desc=Type of port the laser is on." "Value=serial"   "Display=Visible:LaserAutoConnect=true&&Choices:serial;;serial422;;tcp" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserPort" "Parent=Laser_4" "Priority=Expert" "Type=string" "Desc=Port the laser is on." "Value=/dev/ttyUSB6"   "Display=Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserPowerOutput" "Parent=Laser_4" "Priority=Expert" "Type=string" "Desc=Power output that controls this laser's power." "Value=Vertical_Laser_Power"   "Display=Visible:LaserAutoConnect=true&&Choices:;;Main_Laser_Power;;HMI_Power;;WheelLight_Power;;Sonar_1_Power;;Sonar_2_Power;;USB_1_and_2_Power;;USB_3_Power;;Vertical_Laser_Power;;Foot_Laser_Power;;Battery_Out_1;;Battery_Out_2;;Battery_Out_3_and_4;;Aux_5V;;Aux_12V;;Aux_20V;;Audio_Power" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserStartingBaudChoice" "Parent=Laser_4" "Priority=Expert" "Type=string" "Desc=StartingBaud for this laser. Leave blank to use the default." "Value="   "Display=Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserAutoBaudChoice" "Parent=Laser_4" "Priority=Expert" "Type=string" "Desc=AutoBaud for this laser. Leave blank to use the default." "Value="   "Display=Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserIsLow" "Parent=Laser_4" "Priority=Expert" "Type=bool" "Desc=If this laser is a low laser for sensing low obstacles (like feet, pallets, etc)." "Value=false"   "Display=Checkbox&&Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserIsForCartSensing" "Parent=Laser_4" "Priority=Expert" "Type=bool" "Desc=If this laser is the one mounted in the top deck for sensing the cart.  This laser is ignored by path planning." "Value=false"   "Display=Checkbox&&Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserIsTilted" "Parent=Laser_4" "Priority=Expert" "Type=bool" "Desc=The laser is tilted for sensing positive obstacles, i.e. ones above the ground." "Value=true"   "Display=Checkbox&&Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=TiltedFlipped" "Parent=Laser_4" "Priority=Expert" "Type=bool" "Desc=Flip the raw readings from the tilted laser upside-down. Applicable only when LaserIsTilted or LaserIsTiltedNegativeSensor." "Value=false"   "Display=Checkbox&&Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserIsTiltedNegativeSensor" "Parent=Laser_4" "Priority=Expert" "Type=bool" "Desc=Tilted lasers can be used as a secondary protection method against robots encountering negative obstacles (loading docks, stairs, etc.). This detection is only possible in the sensing plane of the tilted laser and cannot be used as the sole means of negative obstacle avoidance. Other primary protection methods should always be used. Talk to your robot provider before using this feature. This is still an experimental beta feature." "Value=false"   "Display=Checkbox&&Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserIsFiltered" "Parent=Laser_4" "Priority=Expert" "Type=bool" "Desc=Readings from the laser must be filtered. This may need to be enabled when the laser can detect the robot's casters (for example). If LaserIsTilted or LaserIsTiltedNegativeSensor is enabled, then this option is disregarded." "Value=false"   "Display=Checkbox&&Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserIsFiltered_v2" "Parent=Laser_4" "Priority=Expert" "Type=bool" "Desc=Readings from the laser must be filtered with the version 2 filter that works even when LaserIsTilted or LaserIsTiltedNegativeSensor is enabled. Like the original LaserIsFiltered parameter, this may need to be enabled when the laser can detect the robot's casters (for example). When enabled, this overrides the LaserIsFiltered value." "Value=true"   "Display=Checkbox&&Visible:LaserAutoConnect=true" 
