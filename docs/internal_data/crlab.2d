LogInfoStrip: CustomInfo: ConfigParam "Name=LaserTh" "Parent=Laser_3" "Priority=Expert" "Type=double" "Desc=Rotation (in deg) of the laser (+ counterclockwise, - clockwise)." "Value=0" "Max=180"  "Display=Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserZ" "Parent=Laser_3" "Priority=Expert" "Type=int" "Desc=Height (in mm) of the laser from the ground. 0 means unknown." "Value=0" "Min=0"  "Display=Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserIgnore" "Parent=Laser_3" "Priority=Expert" "Type=string" "Desc=Angles (in deg) at which to ignore readings, +/1 one degree. Angles are entered as strings, separated by a space." "Value=-120:-180,120:180"   "Display=Visible:LaserAutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserFlipped" "Parent=Laser_3" "Priority=Expert" "Type=bool" "Desc=Laser_3 is upside-down." "Value=false"   "Display=Visible:LaserAutoConnect=true&&Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserType" "Parent=Laser_3" "Priority=Expert" "Type=string" "Desc=Type of laser." "Value=tim3XX"   "Display=Visible:LaserAutoConnect=true&&Choices:s3series;;tim3XX;;tim510;;tim551;;os32c;;os32cethernet" 
