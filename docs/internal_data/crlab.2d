LogInfoStrip: TaskInfo: TaskDesc "Name=laserGreetBox" "Desc=Waits for something to enter the box says something and then tries to drive up to them" "Class=Movement|RobotAudio"
LogInfoStrip: TaskInfo: ArgDesc "Name=width" "Parent=laserGreetBox" "Priority=Important" "Type=int" "Desc=the width of the box to check, measured in mm, centered at the middle of the robot" "Value=2000" "Min=100" 
LogInfoStrip: TaskInfo: ArgDesc "Name=length" "Parent=laserGreetBox" "Priority=Important" "Type=int" "Desc=the length of the box to check, measured in mm, centered at the center of the robot" "Value=2000" "Min=100" 
LogInfoStrip: TaskInfo: ArgDesc "Name=greeting speech" "Parent=laserGreetBox" "Priority=Normal" "Type=string" "Desc=What to say when someone walks into the box before driving up to them. (Special Codes: $g=goal name. Current robot position $X (x in mm) $Y (y in mm) $T (heading in degrees, -180 to 180). Time in GMT: $y=current year, $m=month, $d=day, $H=hour, $M=minute, $S=second.)" "Value="  
LogInfoStrip: TaskInfo: ArgDesc "Name=speed" "Parent=laserGreetBox" "Priority=Normal" "Type=int" "Desc=The speed in mm/sec the robot should move at" "Value=400" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=front clearance" "Parent=laserGreetBox" "Priority=Detailed" "Type=int" "Desc=The distance in mm the robot should stop in front of obstacles" "Value=200"  
LogInfoStrip: TaskInfo: ArgDesc "Name=front padding at stopped" "Parent=laserGreetBox" "Priority=Detailed" "Type=int" "Desc=The padding at 0 velocity" "Value=200"  
LogInfoStrip: TaskInfo: ArgDesc "Name=front padding at speed" "Parent=laserGreetBox" "Priority=Detailed" "Type=int" "Desc=The padding at speed parameter velocity" "Value=400"  
LogInfoStrip: TaskInfo: ArgDesc "Name=max padding deceleration" "Parent=laserGreetBox" "Priority=Detailed" "Type=int" "Desc=The maximum deceleration while still in padding (it will estop if something gets through the padding)" "Value=600"  
LogInfoStrip: TaskInfo: ArgDesc "Name=side clearance" "Parent=laserGreetBox" "Priority=Detailed" "Type=int" "Desc=The distance in mm the robot should leave on the side of obstacles" "Value=50"  
LogInfoStrip: TaskInfo: ArgDesc "Name=transAccel" "Parent=laserGreetBox" "Priority=Detailed" "Type=int" "Desc=The translational acceleration to use, 0 means use robot default" "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=transDecel" "Parent=laserGreetBox" "Priority=Detailed" "Type=int" "Desc=The translational deceleration to use, 0 means use robot default" "Value=0" "Min=0" 
