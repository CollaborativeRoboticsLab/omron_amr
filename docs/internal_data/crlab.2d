LogInfoStrip: CustomInfo: ConfigParam "Name=SATransAccel" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=250" "Max=500"  "Display=Visible:UseSelectableAutonomy=true&&" 
LogInfoStrip: CustomInfo: ConfigParam "Name=SATransDecel" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=200" "Max=800"  "Display=Visible:UseSelectableAutonomy=true&&" 
LogInfoStrip: CustomInfo: ConfigParam "Name=SARotationalSpeed" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=30" "Max=70"  "Display=Visible:UseSelectableAutonomy=true&&" 
LogInfoStrip: CustomInfo: ConfigParam "Name=SARotAccel" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=150" "Max=300"  "Display=Visible:UseSelectableAutonomy=true&&" 
LogInfoStrip: CustomInfo: ConfigParam "Name=SARotDecel" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=150" "Max=300"  "Display=Visible:UseSelectableAutonomy=true&&" 
LogInfoStrip: CustomInfo: ConfigParam "Name=SACentripetalAccel" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=300" "Max=500"  "Display=Visible:UseSelectableAutonomy=true&&" 
LogInfoStrip: CustomInfo: ConfigParam "Name=NotDockingAutoShutdown" "Parent=Docking" "Priority=Normal" "Type=bool" "Desc=Enable an auto-shutdown feature when docking is not active." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=" "Parent=Docking" "Priority=Expert" "Type=unknown" "Desc="   
LogInfoStrip: CustomInfo: ConfigParam "Name=AutoDock" "Parent=Docking" "Priority=Normal" "Type=bool" "Desc=True if we should automatically dock" "Value=false"  
LogInfoStrip: CustomInfo: ConfigParam "Name=AutoDockStateOfCharge" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=If auto docking the robot state of charge to automatically dock at" "Value=0" "Max=100" 
LogInfoStrip: CustomInfo: ConfigParam "Name=AutoDockIdleTime" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=If auto docking the idle time in minutes until auto dock (0 means never auto dock because of idle)" "Value=5" "Min=0" 
LogInfoStrip: CustomInfo: ConfigParam "Name=PreferredDock" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=If there is a charger with this name this robot will use that dock if either OnlyUsePreferredDock is true or the dock is available.  If one of those conditions isn't met or a charger of this name does not exist then the default behavior of using the closest dock (by geometric distance) will apply." "Value="   "Display=MapItem:DockLynx|SubTypeAndParent|Optional" 
LogInfoStrip: CustomInfo: ConfigParam "Name=OnlyUsePreferredDock" "Parent=Docking" "Priority=Normal" "Type=bool" "Desc=If this is true the robot will only use the preferred dock (which will prevent other robots from using it in a central multirobot setup)" "Value=false"   "Display=MapItem:DockLynx|SubTypeAndParent|Optional" 
LogInfoStrip: CustomInfo: ConfigParam "Name=DockUntilDoneCharging" "Parent=Docking" "Priority=Normal" "Type=bool" "Desc=If true then the robot will dock until it is done charging (in float mode)" "Value=true"  
LogInfoStrip: CustomInfo: ConfigParam "Name=MinutesToChargeFor" "Parent=Docking" "Priority=Normal" "Type=int" "Desc=If 0 don't finish charging based on time, if -1 then just undock as soon as docked (mostly for testing) if greater than 0 then be done charging after this many minutes" "Value=0" "Min=-1" 
LogInfoStrip: CustomInfo: ConfigParam "Name=StateOfChargeToChargeTo" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=If 0 don't finish charging based on state of charge, if greater than 0 then be done charging after robot's state of charge reaches this point" "Value=0" "Max=100" 
LogInfoStrip: CustomInfo: ConfigParam "Name=MinutesBetweenAutoDock" "Parent=Docking" "Priority=Normal" "Type=int" "Desc=If 0 don't limit how often the robot can charge, if greater than 0 then this many minutes will elapse between when the robot last docked and when it will autodock" "Value=0" "Min=0" 
LogInfoStrip: CustomInfo: ConfigParam "Name=FailedDriveInIgnoreMinutes" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=The number of minutes to ignore a dock after the robot has failed to drive into it too many times (FailedDriveInAttemptsBeforeIgnore)." "Value=60" "Min=1" 
LogInfoStrip: CustomInfo: ConfigParam "Name=FailedDriveInAttemptsBeforeIgnore" "Parent=Docking" "Priority=Normal" "Type=int" "Desc=The number of times to try to drive into a dock before ignoring it (for FailedDriveInIgnoreMinutes)...  0 means never to ignore a dock for this reason." "Value=3" "Min=0" 
LogInfoStrip: CustomInfo: ConfigParam "Name=SameDockDistanceTolerance" "Parent=Docking" "Priority=Expert" "Type=double" "Desc=For cases where overrideMapName has been used docks within this distance and within SameDockAngleTolerance are counted as the same for purposes of seeing which docks are occupied by other robots." "Value=1000" "Min=1"  "Display=Status:Deprecated" 
LogInfoStrip: CustomInfo: ConfigParam "Name=SameDockAngleTolerance" "Parent=Docking" "Priority=Expert" "Type=double" "Desc=For cases where overrideMapName has been used docks within this angular tolerance and within SameDockDistanceTolerance are counted as the same for purposes of seeing which docks are occupied by other robots." "Value=10" "Min=1"  "Display=Status:Deprecated" 
LogInfoStrip: CustomInfo: ConfigParam "Name=AutoDockShutdownMinutes" "Parent=Docking" "Priority=Normal" "Type=int" "Desc=This controls how long the robot should wait before shutting down if it cannot move on its way to the dock while in a low battery situation.  0 means do not automatically shutdown for this reason, any other value is how many minutes to wait before shutting down" "Value=0" "Max=60" 
LogInfoStrip: CustomInfo: ConfigParam "Name=UnforcedDockShutdownMinutes" "Parent=Docking" "Priority=Normal" "Type=int" "Desc=This controls how long the robot should wait before shutting down if it cannot move on its way to the dock if docking because the robot was idle or an explicit dock request was made.  0 means do not automatically shutdown for this reason, any other value is how many minutes to wait before shutting down" "Value=0" "Max=60" 
LogInfoStrip: CustomInfo: ConfigParam "Name=FinalOffsetX" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Final axial distance in mm from the target center to the AMR center in the coordinate system of the specified target" "Value=-1000" "Max=-300" 
LogInfoStrip: CustomInfo: ConfigParam "Name=FinalOffsetY" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Final lateral distance in mm from the target center to the AMR center in the coordinate system of the specified target" "Value=0" "Max=250" 
LogInfoStrip: CustomInfo: ConfigParam "Name=FinalOffsetAngle" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Final rotation in degrees from the target center to the AMR center in the coordinate system of the specified target" "Value=0" "Max=200" 
LogInfoStrip: CustomInfo: ConfigParam "Name=InitialX" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Initial axial distance in mm from the target center to the AMR center in the coordinate system of the specified target" "Value=-2000" "Max=-1000" 
LogInfoStrip: CustomInfo: ConfigParam "Name=Timeout" "Parent=Docking" "Priority=Normal" "Type=int" "Desc=Elapsed time in seconds from task start before failing" "Value=60" "Max=54000" 
LogInfoStrip: CustomInfo: ConfigParam "Name=PathShape" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=Specifies the path shape the AMR follows to the final location" "Value=PreAlign"   "Display=Choices:PreAlign;;Straight;;PreAlign2" 
LogInfoStrip: CustomInfo: ConfigParam "Name=SearchMode" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=Specifies the size of search area surrounding the Initial location to look for the target" "Value=Normal"   "Display=Choices:Normal;;Wide;;Tall;;Minimum;;Maximum;;Rotation&&" 
LogInfoStrip: CustomInfo: ConfigParam "Name=MatchMode" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=Specifies the allowable deviation between the ideal target shape and the detected shape" "Value=Normal"   "Display=Choices:Normal;;Lenient;;Strict&&" 
LogInfoStrip: CustomInfo: ConfigParam "Name=FailMode" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=Specifies the abnormal conditions that cause the task to fail immediately" "Value=None"   "Display=Choices:None;;FailOnEstop" 
LogInfoStrip: CustomInfo: ConfigParam "Name=PrimaryLaser" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=" "Value=Laser_1"   "Display=Choices:Laser_1;;Laser_2;;Laser_3;;Laser_4;;Laser_5;;Laser_6" 
LogInfoStrip: CustomInfo: ConfigParam "Name=IgnoreDistance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=0" "Max=3000" 
LogInfoStrip: CustomInfo: ConfigParam "Name=DebugMode" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=Specifies what task information is logged for debugging purposes" "Value=Normal"   "Display=Choices:None;;Normal;;Moderate;;Extensive;;All" 
LogInfoStrip: CustomInfo: ConfigParam "Name=ClearanceMode" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=Specifies the area around the AMR for obstacle protection while moving to the final location" "Value=Normal"   "Display=Choices:Normal;;Variable;;Custom" 
LogInfoStrip: CustomInfo: ConfigParam "Name=ApproachDistance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the minimum distance in mm that the AMR should stop when approaching an obstacle" "Value=1000" "Max=8000"  "Display=Visible:ClearanceMode!=Normal" 
LogInfoStrip: CustomInfo: ConfigParam "Name=VirtualObstaclesAreReal" "Parent=Docking" "Priority=Normal" "Type=bool" "Desc=" "Value=true"   "Display=Checkbox&&Visible:false" 
LogInfoStrip: CustomInfo: ConfigParam "Name=ClearanceShape" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=Specifies the footprint shape of the AMR for obstacle protection" "Value=Tight"   "Display=Choices:Normal;;Tight;;Expanded;;Custom" 
LogInfoStrip: CustomInfo: ConfigParam "Name=FrontClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the front clearance zone from the front edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:ClearanceShape=Custom" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LeftClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the left side clearance zone from the left edge of the AMR." "Value=75" "Max=1000"  "Display=Visible:ClearanceShape=Custom" 
LogInfoStrip: CustomInfo: ConfigParam "Name=RightClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the right side clearance zone from the right edge of the AMR." "Value=75" "Max=1000"  "Display=Visible:ClearanceShape=Custom" 
LogInfoStrip: CustomInfo: ConfigParam "Name=BackClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the back side clearance zone from the back edge of the AMR." "Value=20" "Max=1000"  "Display=Visible:ClearanceShape=Custom" 
LogInfoStrip: CustomInfo: ConfigParam "Name=ClearanceSwitchDistance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the distance in mm from the desired final position that the AMR will switch to using the defined Internal Clearances" "Value=300" "Max=3000"  "Display=Visible:ClearanceMode=Variable" 
LogInfoStrip: CustomInfo: ConfigParam "Name=FinalClearanceShape" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=Specifies the footprint shape of the AMR for obstacle protection during the final motion" "Value=Normal"   "Display=Choices:Normal;;Tight;;Expanded;;Custom&&Visible:ClearanceMode=Variable" 
LogInfoStrip: CustomInfo: ConfigParam "Name=FinalFrontClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the front clearance zone from the front edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:ClearanceMode=Variable&&Visible:FinalClearanceShape=Custom" 
LogInfoStrip: CustomInfo: ConfigParam "Name=FinalLeftClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the left side clearance zone from the left edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:ClearanceMode=Variable&&Visible:FinalClearanceShape=Custom" 
LogInfoStrip: CustomInfo: ConfigParam "Name=FinalRightClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the right side clearance zone from the right edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:ClearanceMode=Variable&&Visible:FinalClearanceShape=Custom" 
LogInfoStrip: CustomInfo: ConfigParam "Name=FinalBackClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the back side clearance zone from the back edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:ClearanceMode=Variable&&Visible:FinalClearanceShape=Custom" 
LogInfoStrip: CustomInfo: ConfigParam "Name=DriveMode" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=Specifies how the driving motion is optimized" "Value=Normal"   "Display=Choices:Normal;;Smooth;;Precise;;Fast" 
LogInfoStrip: CustomInfo: ConfigParam "Name=TranslationalSpeed" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Translational speed limit in mm/s" "Value=100" "Max=300"  "Display=Visible:false" 
LogInfoStrip: CustomInfo: ConfigParam "Name=ForwardSpeed" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Forward translational speed limit in mm/s" "Value=100" "Max=300" 
LogInfoStrip: CustomInfo: ConfigParam "Name=ReverseSpeed" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Reverse translational speed limit in mm/s" "Value=-100" "Max=-50" 
LogInfoStrip: CustomInfo: ConfigParam "Name=RotationalSpeed" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Rotational speed limit in deg/s" "Value=30" "Max=50" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingClearanceMode" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=Specifies the area around the AMR for obstacle protection while moving to the final location" "Value=Normal"   "Display=Choices:Normal;;Variable;;Custom" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingApproachDistance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the minimum distance in mm that the AMR should stop when approaching an obstacle" "Value=1000" "Max=8000"  "Display=Visible:CouplingClearanceMode!=Normal&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingTaxiLineApproachDistance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=1000" "Max=8000"  "Display=Visible:CouplingClearanceMode!=Normal&&Visible:CouplingClearanceMode!=Default&&Visible:false&&" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingVirtualObstaclesAreReal" "Parent=Docking" "Priority=Normal" "Type=bool" "Desc=" "Value=true"   "Display=Checkbox&&Visible:false" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingClearanceShape" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=Specifies the footprint shape of the AMR for obstacle protection" "Value=Normal"   "Display=Choices:Normal;;Tight;;Expanded;;Custom;;Polygon&&Visible:CouplingClearanceMode!=Normal" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingFrontClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the front clearance zone from the front edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:CouplingClearanceShape=Custom&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingLeftClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the left side clearance zone from the left edge of the AMR." "Value=75" "Max=1000"  "Display=Visible:CouplingClearanceShape=Custom&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingRightClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the right side clearance zone from the right edge of the AMR." "Value=75" "Max=1000"  "Display=Visible:CouplingClearanceShape=Custom&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingBackClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the back side clearance zone from the back edge of the AMR." "Value=20" "Max=1000"  "Display=Visible:CouplingClearanceShape=Custom&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingClearanceSwitchDistance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the distance in mm from the desired final position that the AMR will switch to using the defined Internal Clearances" "Value=300" "Max=3000"  "Display=Visible:false" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingFinalClearanceShape" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=Specifies the footprint shape of the AMR for obstacle protection during the final motion" "Value=Normal"   "Display=Choices:Normal;;Tight;;Expanded;;Custom&&Visible:false" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingFinalFrontClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the front clearance zone from the front edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:CouplingFinalClearanceShape=Custom&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingFinalLeftClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the left side clearance zone from the left edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:CouplingFinalClearanceShape=Custom&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingFinalRightClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the right side clearance zone from the right edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:CouplingFinalClearanceShape=Custom&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingFinalBackClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Specifies the length in mm of the back side clearance zone from the back edge of the AMR." "Value=50" "Max=1000"  "Display=Visible:CouplingFinalClearanceShape=Custom&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingPolygonClearance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=20" "Max=1000"  "Display=Visible:CouplingClearanceShape=Polygon&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingSlowDownMode" "Parent=Docking" "Priority=Normal" "Type=string" "Desc=" "Value=Normal"   "Display=Choices:Normal;;Tight;;Expanded;;Custom&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingMinimumSlowDownSpeed" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=50" "Max=200"  "Display=Visible:CouplingSlowDownMode=Custom&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingSlowSpeedPaddingWidth" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=150" "Max=2000"  "Display=Visible:CouplingSlowDownMode=Custom&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingSlowSpeedPaddingSpeedLimit" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=300" "Max=1000"  "Display=Visible:CouplingSlowDownMode=Custom&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingFastSpeedPaddingWidth" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=700" "Max=3000"  "Display=Visible:CouplingSlowDownMode=Custom&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingFastSpeedPaddingSpeedLimit" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=1800" "Max=2500"  "Display=Visible:CouplingSlowDownMode=Custom&&Visible:CouplingClearanceMode!=Default" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingMinimumRotationalSlowDownSpeed" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=5" "Max=20"  "Display=Visible:CouplingSlowDownMode=Custom&&Visible:CouplingClearanceMode!=Default&&Visible:false" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingRotationalPaddingRadius" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=400" "Max=3000"  "Display=Visible:CouplingSlowDownMode=Custom&&Visible:CouplingClearanceMode!=Default&&Visible:false" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingRotationalPaddingSpeedLimit" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=" "Value=60" "Max=180"  "Display=Visible:CouplingSlowDownMode=Custom&&Visible:CouplingClearanceMode!=Default&&Visible:false" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingCheckISO3691A1Clearance" "Parent=Docking" "Priority=Normal" "Type=bool" "Desc=" "Value=true"   "Display=Checkbox&&Visible:CouplingSlowDownMode=Custom&&Visible:CouplingClearanceMode!=Default&&Visible:false" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CouplingDistance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Translational distance to dock with the charging station after final alignment" "Value=-325" "Max=-275" 
LogInfoStrip: CustomInfo: ConfigParam "Name=DecouplingDistance" "Parent=Docking" "Priority=Normal" "Type=double" "Desc=Translational distance to decouple from the charging station" "Value=450" "Max=1000" 
LogInfoStrip: CustomInfo: ConfigParam "Name=UseSelectableAutonomy" "Parent=Docking" "Priority=Normal" "Type=bool" "Desc=" "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigSection "Name=Driving problem response"
LogInfoStrip: CustomInfo: ConfigParam "Name=BumpStopAndFailEnabled" "Parent=Driving problem response" "Priority=Expert" "Type=bool" "Desc=When enabled (true), the robot stops for bumps and may eventually fail due to them. When disabled, the robot always tries to extricate itself from the bump." "Value=false"  
LogInfoStrip: CustomInfo: ConfigParam "Name=BumpSecondsToWait" "Parent=Driving problem response" "Priority=Expert" "Type=int" "Desc=Time (in sec) for the robot to wait before moving after a bump." "Value=5"  
LogInfoStrip: CustomInfo: ConfigParam "Name=BumpSecondsToFail" "Parent=Driving problem response" "Priority=Expert" "Type=int" "Desc=Minimum acceptable interval (in sec) between bumps. If more than one bump occurs during this time period, the robot fails to go to its goal." "Value=5"  
LogInfoStrip: CustomInfo: ConfigParam "Name=EmergencyStopFailEnabled" "Parent=Driving problem response" "Priority=Expert" "Type=bool" "Desc=Fail if the emergency stop is pressed." "Value=true"  
LogInfoStrip: CustomInfo: ConfigParam "Name=LostFailEnabled" "Parent=Driving problem response" "Priority=Expert" "Type=bool" "Desc=Fail going to a goal if the robot becomes lost." "Value=true"  
LogInfoStrip: CustomInfo: ConfigParam "Name=LostFailEnabled" "Parent=Driving problem response" "Priority=Expert" "Type=bool" "Desc=Fail going to a goal if the robot becomes lost." "Value=true"  
LogInfoStrip: CustomInfo: ConfigSection "Name=Dynamic Obstacles"
LogInfoStrip: CustomInfo: ConfigParam "Name=Enable" "Parent=Dynamic Obstacles" "Priority=Normal" "Type=bool" "Desc=If this functionality should be enabled" "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=unknown" "Desc="   
LogInfoStrip: CustomInfo: ConfigParam "Name=AdditionalLogging" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=bool" "Desc=If additional logging should be enabled for debugging" "Value=false"   "Display=Visible:Enable=true&&Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=EnableVariableSize" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=bool" "Desc=Enables automatically adjusting obstacle size" "Value=true"   "Display=Visible:Enable=true&&Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=ObstacleSize" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=int" "Desc=Typical size of the obstacles being tracked (mm). This is a minimum size if using variable size." "Value=500" "Min=1"  "Display=Visible:Enable=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=TimeHorizon" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=double" "Desc=How long in the future to predict obstacle motions (sec)" "Value=7.5" "Max=10"  "Display=Visible:Enable=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=MinAvoidanceSpeed" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=double" "Desc=Minimum speed to consider an obstacle in path planning (mm/s)" "Value=300" "Max=2000"  "Display=Visible:Enable=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=MinObstacleAge" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=double" "Desc=Minimum age of an obstacle before it is considered in path planning (s)" "Value=0.3" "Min=0"  "Display=Visible:Enable=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=ForceWithMultirobot" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=bool" "Desc=Force dynamic tracking when multirobot is enabled through an EM" "Value=false"   "Display=Visible:Enable=true&&Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=MinReadings" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=int" "Desc=Minimum number of readings that are clustered into an obstacle observation" "Value=3" "Min=3"  "Display=Visible:Enable=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=MaxNeighborDistance" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=double" "Desc=Maximum distance between laser readings for which they can be together (mm)" "Value=500" "Max=1000"  "Display=Visible:Enable=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=MatchLikelihood" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=string" "Desc=Percent likelihood that a reading will be found for an obstacle. The percentage defines a distance proportional to the obstacle's standard deviation. If a cluster of laser readings is further from the obstacle than that distance, it cannot be an observation for that obstacle" "Value=95"   "Display=Visible:Enable=true&&Choices:99;;97.5;;95;;90;;75" 
LogInfoStrip: CustomInfo: ConfigParam "Name=DisableFilterOccGrid" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=bool" "Desc=Disable the occupancy grid to filter out static obstacle" "Value=false"   "Display=Visible:Enable=true&&Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=FilterOccGridThresh" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=double" "Desc=Threshold for when a cell is considered static in the filtering occ grid (s). If something remains in a single grid cell for this many seconds, it is ignored in tracking" "Value=0.5" "Min=0"  "Display=Visible:Enable=true&&Visible:DisableFilterOccGrid=false" 
LogInfoStrip: CustomInfo: ConfigParam "Name=MaxFilterOccGridValue" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=double" "Desc=Maximum value a cell in the filter occupancy grid can obtain (s)" "Value=2.5" "Min=0"  "Display=Visible:Enable=true&&Visible:DisableFilterOccGrid=false" 
LogInfoStrip: CustomInfo: ConfigParam "Name=PrimaryLaser" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=string" "Desc=Primary Laser to use" "Value=Laser_1"   "Display=Visible:Enable=true&&Choices:Laser_1;;Laser_2;;Laser_3;;Laser_4;;Laser_5;;Laser_6" 
LogInfoStrip: CustomInfo: ConfigParam "Name=SecondaryLaser" "Parent=Dynamic Obstacles" "Priority=Expert" "Type=string" "Desc=Secondary Laser to use" "Value=None"   "Display=Visible:Enable=true&&Choices:None;;Laser_1;;Laser_2;;Laser_3;;Laser_4;;Laser_5;;Laser_6" 
LogInfoStrip: CustomInfo: ConfigSection "Name=Enterprise Manager Connection"
LogInfoStrip: CustomInfo: ConfigParam "Name=UseEnterpriseManagerConfigSections" "Parent=Enterprise Manager Connection" "Priority=Expert" "Type=string" "Desc=Configuration sections that are managed by the Fleet Manager." "Value=All"   "Display=Choices:All;;All except specified;;Only map;;None&&Visible:false" 
LogInfoStrip: CustomInfo: ConfigParam "Name=SpecifiedSectionsToSeparate" "Parent=Enterprise Manager Connection" "Priority=Expert" "Type=unknown" "Desc=Configuration sections to manage on this robot instead of the Fleet Manager."    "Display=Visible:false" 
LogInfoStrip: CustomInfo: ConfigParam "Name=ConnectToEnterpriseManager" "Parent=Enterprise Manager Connection" "Priority=Important" "Type=bool" "Desc=Connect to the Fleet Manager. When enabled, FleetManagerAddress and the robot Identifier must also be specified." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=EnterpriseManagerAddress" "Parent=Enterprise Manager Connection" "Priority=Important" "Type=string" "Desc=IP Address of the Fleet Manager." "Value="   "Display=Visible:ConnectToEnterpriseManager=true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=Identifier" "Parent=Enterprise Manager Connection" "Priority=Important" "Type=string" "Desc=Unique identifier of this robot. This should not be changed after the initial setup." "Value="  
