LogInfoStrip: CustomInfo: ConfigParam "Name=Map" "Parent=Files" "Priority=Important" "Type=string" "Desc=Map of the environment that the robot uses for navigation." "Value=uc_room1.map"   "Display=RobotFile:Map Files (*.map)|*.map" 
LogInfoStrip: CustomInfo: ConfigSection "Name=Fleet Testing Features"
LogInfoStrip: CustomInfo: ConfigParam "Name=QMLearningMode" "Parent=Fleet Testing Features" "Priority=Expert" "Type=bool" "Desc=The Fleet Manager will assign jobs based on learned path distances whenever the information is available" "Value=false"   "Display=Visible:true" 
LogInfoStrip: CustomInfo: ConfigParam "Name=RobotDataThreshold-QMLearning" "Parent=Fleet Testing Features" "Priority=Expert" "Type=double" "Desc=Percentage of available robots with the path distance. The Fleet Manager will assign jobs based on path distance only when the required data is present for this percentage of Available robots. If not, the Fleet Manager will use the classic Euclidean distance" "Value=0.6" "Max=1"  "Display=Visible:false" 
LogInfoStrip: CustomInfo: ConfigSection "Name=General"
LogInfoStrip: CustomInfo: ConfigParam "Name=" "Parent=General" "Priority=Factory" "Type=unknown" "Desc="   
LogInfoStrip: CustomInfo: ConfigParam "Name=UseStandardFeedback" "Parent=General" "Priority=Factory" "Type=bool" "Desc=Robot is equipped with standard feedback (wheel lights and light pole) and the feedback behavior should be enabled." "Value=true"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=Radius" "Parent=General" "Priority=Factory" "Type=double" "Desc=Radius (in mm) that is needed to turn in place safely." "Value=705" "Min=1" 
LogInfoStrip: CustomInfo: ConfigParam "Name=Width" "Parent=General" "Priority=Factory" "Type=double" "Desc=Width (in mm) of the robot." "Value=920" "Min=1" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LengthFront" "Parent=General" "Priority=Factory" "Type=double" "Desc=Length (in mm) from the idealized center of rotation to the front of the robot." "Value=610" "Min=1" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LengthRear" "Parent=General" "Priority=Factory" "Type=double" "Desc=Length (in mm) from the idealized center of rotation to the rear of the robot." "Value=535" "Min=1" 
LogInfoStrip: CustomInfo: ConfigParam "Name=DistanceCalibrationFactor" "Parent=General" "Priority=Calibration" "Type=double" "Desc=Calibration factor (multiplier) for distance errors on this particular vehicle. A perfect vehicle would have a value of 1.0. Traveled distances are multiplied by this factor, so if the vehicle drove 1% too far during calibration, then this value should be set to 0.99." "Value=1" "Min=0" 
LogInfoStrip: CustomInfo: ConfigParam "Name=NumberOfFrontBumpers" "Parent=General" "Priority=Factory" "Type=int" "Desc=Number of front bumpers." "Value=0" "Max=7"  "Display=SpinBox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=NumberOfRearBumpers" "Parent=General" "Priority=Factory" "Type=int" "Desc=Number of rear bumpers." "Value=0" "Max=7"  "Display=SpinBox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=MaxNumberOfLasers" "Parent=General" "Priority=Factory" "Type=int" "Desc=Maximum number of lasers." "Value=5" "Max=9"  "Display=SpinBox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=MaxNumberOfBatteries" "Parent=General" "Priority=Factory" "Type=int" "Desc=Maximum number of batteries." "Value=1" "Max=9"  "Display=SpinBox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=MaxNumberOfLCDs" "Parent=General" "Priority=Factory" "Type=int" "Desc=Maximum number of LCDs." "Value=1" "Max=9"  "Display=SpinBox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=MaxNumberOfSonarBoards" "Parent=General" "Priority=Factory" "Type=int" "Desc=Maximum number of sonar boards." "Value=0" "Max=9"  "Display=SpinBox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=MaxNumberOfTimeOfFlightBoards" "Parent=General" "Priority=Factory" "Type=int" "Desc=Max number of Time Of Flight Boards." "Value=1" "Max=9"  "Display=SpinBox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=DockType" "Parent=General" "Priority=Expert" "Type=string" "Desc=Type of dock required by this platform." "Value=LD"   "Display=Choices:LD;;Lynx;;None" 
