LogInfoStrip: CustomInfo: ConfigParam "Name=AutoConnect" "Parent=GuideSensor_Front" "Priority=Expert" "Type=bool" "Desc=GuideSensor_Front exists and should be automatically connected at startup" "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=Port" "Parent=GuideSensor_Front" "Priority=Expert" "Type=string" "Desc=Port the guide sensor is on" "Value=/dev/ttyUSB9"   "Display=Visible:AutoConnect=true" 
LogInfoStrip: CustomInfo: ConfigSection "Name=GuideSensor_Rear"
