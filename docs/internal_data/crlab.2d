LogInfoStrip: CustomInfo: ConfigParam "Name=ClearanceSwitchDistance" "Parent=Move: Path Defaults" "Priority=Normal" "Type=double" "Desc=Specifies the distance in mm from the desired final position that the AMR will switch to using the defined Internal Clearances." "Value=300" "Max=3000"  "Display=Visible:false" 
LogInfoStrip: CustomInfo: ConfigParam "Name=FinalClearanceShape" "Parent=Move: Path Defaults" "Priority=Normal" "Type=string" "Desc=Specifies the footprint shape of the AMR for obstacle protection during the final motion." "Value=Normal"   "Display=Choices:Normal;;Tight;;Expanded;;Custom&&Visible:false" 
