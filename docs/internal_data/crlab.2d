LogInfoStrip: CustomInfo: ConfigSection "Name=Custom Arguments"
LogInfoStrip: CustomInfo: ConfigParam "Name=CustomArguments" "Parent=Custom Arguments" "Priority=Factory" "Type=unknown" "Desc=Custom arguments to be passed to ARAM on startup. (This replaces the Custom Arguments entry box previously available in the ARAM section of SetNetGo)."   
LogInfoStrip: CustomInfo: ConfigSection "Name=Custom Enterprise Queuing Tasks"
LogInfoStrip: CustomInfo: ConfigParam "Name=CustomEnterpriseQueuingTasks" "Parent=Custom Enterprise Queuing Tasks" "Priority=Normal" "Type=unknown" "Desc=Custom tasks for use with Fleet Queuing.  Only robots that have all the tasks associated with a goal can service jobs for that goal.  Use these customs tasks as a way to divide goals between robots."   
LogInfoStrip: CustomInfo: ConfigSection "Name=CustomCart"
LogInfoStrip: CustomInfo: ConfigParam "Name=CartFilter" "Parent=CustomCart" "Priority=Expert" "Type=bool" "Desc=Enables a cart filter, which removes other carts alongside a cart in right position. This should only be used in very specific cases where carts locate side by side each other." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=" "Parent=CustomCart" "Priority=Expert" "Type=unknown" "Desc="   
LogInfoStrip: CustomInfo: ConfigSection "Name=Data Log Settings"
LogInfoStrip: CustomInfo: ConfigParam "Name=Log" "Parent=Data Log Settings" "Priority=Expert" "Type=bool" "Desc=Enable logging of the selected data. If logging is turned off and on while ARAM is running, then new log entries are appended to the previous data log file if possible. (If the selected data types are changed, then a new log file is created.)" "Value=false"  
LogInfoStrip: CustomInfo: ConfigParam "Name=LogInterval" "Parent=Data Log Settings" "Priority=Expert" "Type=double" "Desc=Time (in sec) between data log entries.  0 means log data every cycle.  Fractional seconds are allowed, but note that the actual logging interval will vary slightly based on the execution cycles." "Value=0" "Min=0" 
LogInfoStrip: CustomInfo: ConfigParam "Name=" "Parent=Data Log Settings" "Priority=Expert" "Type=unknown" "Desc="   
LogInfoStrip: CustomInfo: ConfigParam "Name=LogEachMaxMegs" "Parent=Data Log Settings" "Priority=Expert" "Type=double" "Desc=Maximum size (in MB) of an individual data log file. 0 means no limit." "Value=0" "Min=0" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LogEachMaxLines" "Parent=Data Log Settings" "Priority=Expert" "Type=int" "Desc=Maximum number of lines in an individual data log file. 0 means no limit." "Value=30000" "Min=0" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LogTotalMaxMegs" "Parent=Data Log Settings" "Priority=Expert" "Type=double" "Desc=Maximum size (in MB) of all the data log files combined." "Value=30" "Min=0" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LogTotalNumFiles" "Parent=Data Log Settings" "Priority=Expert" "Type=int" "Desc=Maximum number of data log files to store. 0 means no limit." "Value=0" "Min=0" 
LogInfoStrip: CustomInfo: ConfigParam "Name=UseNewFileAtStartup" "Parent=Data Log Settings" "Priority=Expert" "Type=bool" "Desc=When enabled, a new data log file is created at startup. Otherwise, entries are appended to the previous data log file if possible. (If the selected data types are changed, then a new log file is created.)" "Value=false"  
LogInfoStrip: CustomInfo: ConfigParam "Name=FormatNames" "Parent=Data Log Settings" "Priority=Expert" "Type=bool" "Desc=True to replace names with spaces and make the first letter upper-case, false to leave the names as such" "Value=true"  
