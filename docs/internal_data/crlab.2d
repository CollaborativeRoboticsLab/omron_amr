LogInfoStrip: TaskInfo: ArgDesc "Name=TaxiLineApproachDistance" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=" "Value=1000" "Max=8000"  "Display=Visible:ClearanceMode!=Normal&&Visible:ClearanceMode!=Default&&Visible:false&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=VirtualObstaclesAreReal" "Parent=Move: Segment" "Priority=Detailed" "Type=bool" "Desc=Treat virtual obstacles (Forbidden Area, etc) as real obstacles" "Value=false"   "Display=Checkbox&&Visible:false" 
LogInfoStrip: TaskInfo: ArgDesc "Name=ClearanceShape" "Parent=Move: Segment" "Priority=Detailed" "Type=string" "Desc=Specifies the footprint shape of the AMR for obstacle protection" "Value=Normal"   "Display=Choices:Normal;;Tight;;Expanded;;Custom;;Polygon&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FrontClearance" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the front clearance zone from the front edge of the AMR." "Value=0" "Max=1000"  "Display=Visible:ClearanceShape=Custom&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=LeftClearance" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the left side clearance zone from the left edge of the AMR." "Value=0" "Max=1000"  "Display=Visible:ClearanceShape=Custom&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=RightClearance" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the right side clearance zone from the right edge of the AMR." "Value=0" "Max=1000"  "Display=Visible:ClearanceShape=Custom&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=BackClearance" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the back side clearance zone from the back edge of the AMR." "Value=0" "Max=1000"  "Display=Visible:ClearanceShape=Custom&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=ClearanceSwitchDistance" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Specifies the distance in mm from the desired final position that the AMR will switch to using the defined Internal Clearances" "Value=1500" "Max=3000"  "Display=Visible:false" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FinalClearanceShape" "Parent=Move: Segment" "Priority=Detailed" "Type=string" "Desc=Specifies the footprint shape of the AMR for obstacle protection during the final motion" "Value=Normal"   "Display=Choices:Normal;;Tight;;Expanded;;Custom&&Visible:false" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FinalFrontClearance" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the front clearance zone from the front edge of the AMR." "Value=0" "Max=1000"  "Display=Visible:FinalClearanceShape=Custom&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FinalLeftClearance" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the left side clearance zone from the left edge of the AMR." "Value=0" "Max=1000"  "Display=Visible:FinalClearanceShape=Custom&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FinalRightClearance" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the right side clearance zone from the right edge of the AMR." "Value=0" "Max=1000"  "Display=Visible:FinalClearanceShape=Custom&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FinalBackClearance" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Specifies the length in mm of the back side clearance zone from the back edge of the AMR." "Value=0" "Max=1000"  "Display=Visible:FinalClearanceShape=Custom&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=PolygonClearance" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=" "Value=20" "Max=1000"  "Display=Visible:ClearanceShape=Polygon&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=SlowDownMode" "Parent=Move: Segment" "Priority=Detailed" "Type=string" "Desc=" "Value=Normal"   "Display=Choices:Normal;;Tight;;Expanded;;Custom&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=MinimumSlowDownSpeed" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=" "Value=50" "Max=200"  "Display=Visible:SlowDownMode=Custom&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=SlowSpeedPaddingWidth" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=" "Value=150" "Max=2000"  "Display=Visible:SlowDownMode=Custom&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=SlowSpeedPaddingSpeedLimit" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=" "Value=300" "Max=1000"  "Display=Visible:SlowDownMode=Custom&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FastSpeedPaddingWidth" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=" "Value=700" "Max=3000"  "Display=Visible:SlowDownMode=Custom&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=FastSpeedPaddingSpeedLimit" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=" "Value=1800" "Max=2500"  "Display=Visible:SlowDownMode=Custom&&Visible:ClearanceMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=MinimumRotationalSlowDownSpeed" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=" "Value=5" "Max=20"  "Display=Visible:SlowDownMode=Custom&&Visible:ClearanceMode!=Default&&Visible:false" 
LogInfoStrip: TaskInfo: ArgDesc "Name=RotationalPaddingRadius" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=" "Value=400" "Max=3000"  "Display=Visible:SlowDownMode=Custom&&Visible:ClearanceMode!=Default&&Visible:false" 
LogInfoStrip: TaskInfo: ArgDesc "Name=RotationalPaddingSpeedLimit" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=" "Value=60" "Max=180"  "Display=Visible:SlowDownMode=Custom&&Visible:ClearanceMode!=Default&&Visible:false" 
LogInfoStrip: TaskInfo: ArgDesc "Name=CheckISO3691A1Clearance" "Parent=Move: Segment" "Priority=Detailed" "Type=bool" "Desc=" "Value=true"   "Display=Checkbox&&Visible:SlowDownMode=Custom&&Visible:ClearanceMode!=Default&&Visible:false" 
LogInfoStrip: TaskInfo: ArgDesc "Name=DriveMode" "Parent=Move: Segment" "Priority=Detailed" "Type=string" "Desc=Specifies how the driving motion is optimized" "Value=Default"   "Display=Choices:Default;;Normal;;Smooth;;Precise;;Fast" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TranslationalSpeed" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Translational speed limit in mm/s" "Value=100" "Max=1800"  "Display=Visible:false" 
LogInfoStrip: TaskInfo: ArgDesc "Name=ForwardSpeed" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Forward translational speed limit in mm/s" "Value=100" "Max=1800"  "Display=Visible:DriveMode!=Default&&" 
LogInfoStrip: TaskInfo: ArgDesc "Name=ReverseSpeed" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Reverse translational speed limit in mm/s" "Value=-100" "Max=-10"  "Display=Visible:DriveMode!=Default&&" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TransAccel" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Translational acceleration limit in mm/s/s." "Value=400" "Max=1000"  "Display=Visible:DriveMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=TransDecel" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Translational deceleration limit in mm/s/s." "Value=400" "Max=1000"  "Display=Visible:DriveMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=RotationalSpeed" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Rotational speed limit in deg/s" "Value=30" "Max=90"  "Display=Visible:DriveMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=RotAccel" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Rotational acceleration limit in degrees/s/s." "Value=100" "Max=300"  "Display=Visible:DriveMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=RotDecel" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Rotational deceleration limit in degrees/s/s." "Value=150" "Max=300"  "Display=Visible:DriveMode!=Default" 
LogInfoStrip: TaskInfo: ArgDesc "Name=CentripetalAccel" "Parent=Move: Segment" "Priority=Detailed" "Type=double" "Desc=Cornering acceleration limit in mm/s/s." "Value=300" "Max=800"  "Display=Visible:DriveMode!=Default" 
LogInfoStrip: TaskInfo: TaskDesc "Name=gotoRandom" "Desc=Drives to a random goal, which may be optionally constrained by a matching name prefix." "Class=Movement"
LogInfoStrip: TaskInfo: ArgDesc "Name=prefix" "Parent=gotoRandom" "Priority=Normal" "Type=string" "Desc=If a prefix is specified, then only goal names that start with the prefix are selected. If blank, then any goal is selected. Wildcards are not supported." "Value="  
LogInfoStrip: TaskInfo: TaskDesc "Name=localizeAtGoal" "Desc=<p><blockquote><b><font color=#A91B16>Use with caution. This task can cause the robot to become lost.  <nobr> Do not use the task without explicit user input.</nobr></font></b></blockquote></p><p>Localizes at a specified goal.</p>" "Class=Localize|Instant"
LogInfoStrip: TaskInfo: ArgDesc "Name=goal to localize at" "Parent=localizeAtGoal" "Priority=Important" "Type=string" "Desc=Name of the goal at which to localize." "Value="   "Display=MapItem:Goal|SubtypeAndParent|Required" 
LogInfoStrip: TaskInfo: ArgDesc "Name=xySpread" "Parent=localizeAtGoal" "Priority=Normal" "Type=double" "Desc=Distance (in mm) to spread the localization. 0 means do not spread. -1 means use the default spread." "Value=-1"  
LogInfoStrip: TaskInfo: ArgDesc "Name=angleSpread" "Parent=localizeAtGoal" "Priority=Normal" "Type=double" "Desc=Angle (in deg) to spread the localization. 0 means do not spread. -1 means use the default spread." "Value=-1"  
LogInfoStrip: TaskInfo: TaskDesc "Name=wait" "Desc=Waits for the specified number of seconds. The wait may be interrupted by an explicit continue command." "Class=Timing"
LogInfoStrip: TaskInfo: ArgDesc "Name=seconds to wait" "Parent=wait" "Priority=Important" "Type=int" "Desc=Number of seconds to wait." "Value=5" "Min=1" 
LogInfoStrip: TaskInfo: ArgDesc "Name=status to wait with" "Parent=wait" "Priority=Detailed" "Type=string" "Desc=Status message to broadcast during the wait." "Value=Waiting"  
LogInfoStrip: TaskInfo: ArgDesc "Name=premotion blink" "Parent=wait" "Priority=Detailed" "Type=bool" "Desc=When enabled (true), the robot performs the pre-motion blinking action during the wait period." "Value=false"  
LogInfoStrip: TaskInfo: TaskDesc "Name=waitIndefinitely" "Desc=Waits until commanded otherwise" "Class=Timing"
LogInfoStrip: TaskInfo: ArgDesc "Name=status to pause with" "Parent=waitIndefinitely" "Priority=Detailed" "Type=string" "Desc=The status message to have while Pausing" "Value=Pausing"  
LogInfoStrip: TaskInfo: TaskDesc "Name=waitActive" "Desc=Calls a macro, and optionally waits a given number of seconds or until told to continue by command and control" "Class=Timing"
LogInfoStrip: TaskInfo: ArgDesc "Name=wait type" "Parent=waitActive" "Priority=Detailed" "Type=string" "Desc=The wait type. Specified length: call the macro (if any) then wait until timeout. If the macro does not complete in the timeout, then abort the macro. Macro length: call the macro (if any) then terminate. Forever: call the macro (if any) then wait endlessly (until the task is cancelled)." "Value=Specified length"   "Display=Choices:Specified length;;Macro length;;Forever" 
LogInfoStrip: TaskInfo: ArgDesc "Name=seconds to wait" "Parent=waitActive" "Priority=Important" "Type=int" "Desc=The number of seconds to wait" "Value=5" "Min=1" 
LogInfoStrip: TaskInfo: ArgDesc "Name=status to wait with" "Parent=waitActive" "Priority=Detailed" "Type=string" "Desc=The status message to have while waiting" "Value=Waiting"  
LogInfoStrip: TaskInfo: ArgDesc "Name=premotion blink" "Parent=waitActive" "Priority=Detailed" "Type=bool" "Desc=Whether to do the pre motion blink while waiting" "Value=false"  
LogInfoStrip: TaskInfo: ArgDesc "Name=macro" "Parent=waitActive" "Priority=Normal" "Type=string" "Desc=the macro (if any) to call during the wait sequence" "Value="   "Display=Macro" 
LogInfoStrip: TaskInfo: ArgDesc "Name=lockMode" "Parent=waitActive" "Priority=Normal" "Type=bool" "Desc=Whether to lock the mode.  If it is locked it will remain locked until the wait is either cancelled or failed." "Value=false"   "Display=Checkbox" 
LogInfoStrip: TaskInfo: ArgDesc "Name=succeeded macro" "Parent=waitActive" "Priority=Normal" "Type=string" "Desc=the macro (if any) to call after the wait finishes successfully (a cancelled wait counts as successful)" "Value="   "Display=Macro" 
LogInfoStrip: TaskInfo: ArgDesc "Name=failed macro" "Parent=waitActive" "Priority=Normal" "Type=string" "Desc=the macro (if any) to call after the wait is failed" "Value="   "Display=Macro" 
LogInfoStrip: TaskInfo: TaskDesc "Name=waitCancel" "Desc=Cancels any wait in progress (causing it to succeed)" "Class=Instant"
LogInfoStrip: TaskInfo: TaskDesc "Name=waitFail" "Desc=Fails any wait in progress" "Class=Instant"
LogInfoStrip: TaskInfo: TaskDesc "Name=laserCheckBox" "Desc=Waits for something to enter the rectangular area surrounding the robot. Macros may be triggered upon detection or timeout." "Class=Monitor"
LogInfoStrip: TaskInfo: ArgDesc "Name=width" "Parent=laserCheckBox" "Priority=Important" "Type=int" "Desc=Width (in mm) of the area to check, centered at the center of the robot." "Value=2000" "Min=100" 
LogInfoStrip: TaskInfo: ArgDesc "Name=length" "Parent=laserCheckBox" "Priority=Important" "Type=int" "Desc=Length (in mm) of the area to check, centered at the center of the robot." "Value=2000" "Min=100" 
LogInfoStrip: TaskInfo: ArgDesc "Name=triggerMacro" "Parent=laserCheckBox" "Priority=Normal" "Type=string" "Desc=Macro to invoke when something is detected in the area. Optional." "Value="   "Display=Macro" 
LogInfoStrip: TaskInfo: ArgDesc "Name=timeout" "Parent=laserCheckBox" "Priority=Normal" "Type=int" "Desc=Maximum duration (in sec) to wait for something to be detected. 0 means wait forever." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=timeoutMacro" "Parent=laserCheckBox" "Priority=Normal" "Type=string" "Desc=Macro to invoke if nothing is detected in the area within the specified timeout. Optional." "Value="   "Display=Macro" 
LogInfoStrip: TaskInfo: TaskDesc "Name=laserCheckEmptyBox" "Desc=Waits for the rectangular area surrounding the robot to be empty. Macros may be triggered upon detection or timeout." "Class=Monitor"
LogInfoStrip: TaskInfo: ArgDesc "Name=width" "Parent=laserCheckEmptyBox" "Priority=Important" "Type=int" "Desc=Width (in mm) of the area to check, centered at the center of the robot." "Value=2000" "Min=100" 
LogInfoStrip: TaskInfo: ArgDesc "Name=length" "Parent=laserCheckEmptyBox" "Priority=Important" "Type=int" "Desc=Length (in mm) of the area to check, centered at the center of the robot." "Value=2000" "Min=100" 
LogInfoStrip: TaskInfo: ArgDesc "Name=triggerMacro" "Parent=laserCheckEmptyBox" "Priority=Normal" "Type=string" "Desc=Macro to invoke when the area becomes empty. Optional." "Value="   "Display=Macro" 
LogInfoStrip: TaskInfo: ArgDesc "Name=timeout" "Parent=laserCheckEmptyBox" "Priority=Normal" "Type=int" "Desc=Maximum duration (in sec) to wait for the area to become empty. 0 means wait forever." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=timeoutMacro" "Parent=laserCheckEmptyBox" "Priority=Normal" "Type=string" "Desc=Macro to invoke the area does not become empty within the specified timeout. Optional." "Value="   "Display=Macro" 
LogInfoStrip: TaskInfo: TaskDesc "Name=laserCheckPolar" "Desc=Waits for something to enter the angular area (i.e. pie slice) surrounding the robot. Macros may be triggered upon detection or timeout." "Class=Monitor"
LogInfoStrip: TaskInfo: ArgDesc "Name=start angle" "Parent=laserCheckPolar" "Priority=Important" "Type=int" "Desc=Start angle (in deg) of the area to check. This should be less than the end angle. (Otherwise, the slice is inverted.)" "Value=-45" "Max=180" 
LogInfoStrip: TaskInfo: ArgDesc "Name=end angle" "Parent=laserCheckPolar" "Priority=Important" "Type=int" "Desc=End angle (in deg) of the area to check. This should be greater than the start angle. (Otherwise, the slice is inverted.)" "Value=45" "Max=180" 
LogInfoStrip: TaskInfo: ArgDesc "Name=dist" "Parent=laserCheckPolar" "Priority=Important" "Type=int" "Desc=Length (in mm) of the area, extending from the front of the robot." "Value=1000" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=triggerMacro" "Parent=laserCheckPolar" "Priority=Normal" "Type=string" "Desc=Macro to invoke when something is detected in the area. Optional." "Value="   "Display=Macro" 
LogInfoStrip: TaskInfo: ArgDesc "Name=timeout" "Parent=laserCheckPolar" "Priority=Normal" "Type=int" "Desc=Maximum duration (in sec) to wait for something to be detected. 0 means wait forever." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=timeoutMacro" "Parent=laserCheckPolar" "Priority=Normal" "Type=string" "Desc=Macro to invoke if nothing is detected in the area within the specified timeout. Optional." "Value="   "Display=Macro" 
LogInfoStrip: TaskInfo: TaskDesc "Name=makeClientsBeep" "Desc=Requests that the client applications emit a beep. (Client applications include MobilePlanner and MobileEyes.)  Audio must be properly configured on the client." "Class=ClientAudio|Instant"
LogInfoStrip: TaskInfo: TaskDesc "Name=move" "Desc=Moves forward by the specified distance, provided that no obstacles are encountered." "Class=Movement"
LogInfoStrip: TaskInfo: ArgDesc "Name=distance" "Parent=move" "Priority=Important" "Type=int" "Desc=Distance (in mm) to move forward from the current location." "Value=1000"  
LogInfoStrip: TaskInfo: ArgDesc "Name=speed" "Parent=move" "Priority=Normal" "Type=int" "Desc=Speed (in mm/sec) at which to move." "Value=400" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=front clearance" "Parent=move" "Priority=Detailed" "Type=int" "Desc=Distance (in mm) to maintain between the front of the robot and any obstacles." "Value=200"  
LogInfoStrip: TaskInfo: ArgDesc "Name=side clearance" "Parent=move" "Priority=Detailed" "Type=int" "Desc=Distance (in mm) to maintain between the side of the robot and any obstacles." "Value=50"  
LogInfoStrip: TaskInfo: ArgDesc "Name=time until fail" "Parent=move" "Priority=Detailed" "Type=int" "Desc=Duration (in sec) to wait for an obstacle to clear before declaring that the move has failed." "Value=30" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=transAccel" "Parent=move" "Priority=Detailed" "Type=int" "Desc=Acceleration (in mm/sec/sec) for the move. 0 means use the robot's default acceleration." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=transDecel" "Parent=move" "Priority=Detailed" "Type=int" "Desc=Deceleration (in mm/sec/sec) for the move. 0 means use the robot's default acceleration." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=minimum time" "Parent=move" "Priority=Detailed" "Type=int" "Desc=Minimum duration (in sec) of this task. If the robot reaches the destination in less time, the task waits for the remainder of the duration. 0 means that task should complete as soon as the robot reaches the destination." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=AvoidLocationDependentObstacles" "Parent=move" "Priority=Detailed" "Type=bool" "Desc=When enabled (true), the robot avoids location-dependent obstacles like forbidden lines and other robots. If this is disabled, then physical guards must be used to contain the robot." "Value=true"  
LogInfoStrip: TaskInfo: ArgDesc "Name=always succeed" "Parent=move" "Priority=Detailed" "Type=bool" "Desc=Return success regardless of the distance moved. When enabled, the tasks will report success even if the destination is not reached. When disabled, the task fails if the destination is not reached." "Value=false"  
LogInfoStrip: TaskInfo: ArgDesc "Name=finish if stopped" "Parent=move" "Priority=Detailed" "Type=bool" "Desc=Finish the task if the robot cannot move after the first two seconds. When enabled, the task finishes as soon as the robot cannot move. When disabled, the robot must be blocked for the specified 'time until fail' before the task is finished." "Value=true"  
LogInfoStrip: TaskInfo: TaskDesc "Name=setHeading" "Desc=Turns to a specified global orientation / heading." "Class=Movement|Heading"
LogInfoStrip: TaskInfo: ArgDesc "Name=heading" "Parent=setHeading" "Priority=Important" "Type=int" "Desc=Global heading (in deg) to which to turn." "Value=0" "Max=180" 
LogInfoStrip: TaskInfo: ArgDesc "Name=rotVelMax" "Parent=setHeading" "Priority=Detailed" "Type=int" "Desc=Maximum rotational velocity (in deg/sec) when turning. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=rotAccel" "Parent=setHeading" "Priority=Detailed" "Type=int" "Desc=Rotational acceleration (in deg/sec/sec) when turning. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=rotDecel" "Parent=setHeading" "Priority=Detailed" "Type=int" "Desc=Rotational deceleration (in deg/sec/sec) when turning. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=time until fail" "Parent=setHeading" "Priority=Detailed" "Type=int" "Desc=Duration (in sec) to wait if unable to turn before declaring that the task has failed." "Value=30" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=minimum time" "Parent=setHeading" "Priority=Detailed" "Type=int" "Desc=Minimum duration (in sec) of this task. If the robot reaches the destination heading in less time, the task waits for the remainder of the duration. 0 means that task should complete as soon as the robot reaches the destination heading." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: TaskDesc "Name=deltaHeading" "Desc=Changes the heading by the specified relative amount." "Class=Movement|Heading"
LogInfoStrip: TaskInfo: ArgDesc "Name=delta heading" "Parent=deltaHeading" "Priority=Important" "Type=int" "Desc=Amount (in deg) by which to turn the robot. Use positive values to turn the robot left/counterclockwise; negative values to turn it right/clockwise. Note that if the absolute value exceeds 360, then the robot will make at least one complete rotation." "Value=0"  
LogInfoStrip: TaskInfo: ArgDesc "Name=rotVelMax" "Parent=deltaHeading" "Priority=Detailed" "Type=int" "Desc=Maximum rotational velocity (in deg/sec) when turning. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=rotAccel" "Parent=deltaHeading" "Priority=Detailed" "Type=int" "Desc=Rotational acceleration (in deg/sec/sec) when turning. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=rotDecel" "Parent=deltaHeading" "Priority=Detailed" "Type=int" "Desc=Rotational deceleration (in deg/sec/sec) when turning. 0 means use the default." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=time until fail" "Parent=deltaHeading" "Priority=Detailed" "Type=int" "Desc=Duration (in sec) to wait if unable to turn before declaring that the task has failed." "Value=30" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=minimum time" "Parent=deltaHeading" "Priority=Detailed" "Type=int" "Desc=Minimum duration (in sec) of this task. If the robot reaches the destination heading in less time, the task waits for the remainder of the duration. 0 means that task should complete as soon as the robot reaches the destination heading." "Value=0" "Min=0" 
LogInfoStrip: TaskInfo: ArgDesc "Name=use localization" "Parent=deltaHeading" "Priority=Detailed" "Type=bool" "Desc=True to use localization while turning. False to rely solely on the odometry." "Value=true"  
LogInfoStrip: TaskInfo: ArgDesc "Name=checkRadius" "Parent=deltaHeading" "Priority=Detailed" "Type=bool" "Desc=Stop the robot from rotating when there is an object within a user-defined radius." "Value=false"  
LogInfoStrip: TaskInfo: ArgDesc "Name=radiusAdjustment" "Parent=deltaHeading" "Priority=Detailed" "Type=int" "Desc=The additional radius (mm) beyond the robot's radius to check for obstacles when rotating." "Value=0"  
LogInfoStrip: TaskInfo: TaskDesc "Name=popupSimple" "Desc=Requests that the client applications show a simple popup message. (Client applications include MobilePlanner and MobileEyes.)" "Class=Instant"
LogInfoStrip: TaskInfo: ArgDesc "Name=Title" "Parent=popupSimple" "Priority=Important" "Type=string" "Desc=Title of the popup message. If blank, then the 'Do not show again' checkbox is omitted." "Value="  
LogInfoStrip: TaskInfo: ArgDesc "Name=Message" "Parent=popupSimple" "Priority=Important" "Type=string" "Desc=Message to be displayed in the popup message. Must be specified." "Value="  
LogInfoStrip: TaskInfo: ArgDesc "Name=Button label" "Parent=popupSimple" "Priority=Important" "Type=string" "Desc=Label on the button in the popup message." "Value=OK"  
LogInfoStrip: TaskInfo: ArgDesc "Name=Button timeout" "Parent=popupSimple" "Priority=Important" "Type=int" "Desc=Duration (in sec) of the popup message. 0 means that the popup should be displayed until the button is pressed." "Value=0" "Max=65536" 
LogInfoStrip: TaskInfo: TaskDesc "Name=macroRepeat" "Desc=Repeatedly invokes a macro, for the specified number of times or until the macro fails."
LogInfoStrip: TaskInfo: ArgDesc "Name=macro" "Parent=macroRepeat" "Priority=Important" "Type=string" "Desc=Name of the macro to invoke." "Value="   "Display=Macro" 
LogInfoStrip: TaskInfo: ArgDesc "Name=repeatTimes" "Parent=macroRepeat" "Priority=Normal" "Type=int" "Desc=Number of times to call the macro. -1 means repeat forever or until the macro fails." "Value=-1" "Min=-1" 
