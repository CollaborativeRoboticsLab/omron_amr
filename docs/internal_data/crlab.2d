LogInfoStrip: CustomInfo: ConfigParam "Name=_standbyManagedMotionStateAndCommands" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra logging of the state and commands." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=_standbyManagedMotionRedirectInfo" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra logging of the redirect information." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=_standbyManagedMotionReclaim" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra logging of the reclaiming." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=_standbyBufferingParkingStateAndCommands" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra logging of the state and commands." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=_standbyBufferingParkingRedirectInfo" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra logging of the redirect information." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=_standbyBufferingParkingReclaim" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra logging of the reclaiming." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=CentralStandbyAssign" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra verbose logging for AramCentralStandby that shows what assignment message packets will be sent to robots." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=QmRobotIntf" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=" "Value=true"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=ExtraLogging" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra logging that we may want AEs to turn on to get us more information.   These will show up with the <extraLogging:> prefix" "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LaserFilter_v2::Laser_1:Log" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Whether to log filtered laser readings or not" "Value=false"  
LogInfoStrip: CustomInfo: ConfigParam "Name=TaskTracingLogging" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables logging of task tracing (normally you just watch it in MobilePlanner->Monitor->Task tracing." "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=QmFaultsTrace" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables (the default) extra logging path Queuing Manager fault packets sent, received and validated. These will show up with the <AramCentralQMFaults> prefix" "Value=true"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=QmJobHistory" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra logging that logs job history. These will show up with the <AramCentralQMJobTranactions::> prefix" "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=QmQmIntf" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra logging path for packets sent, received and validated. These will show up with the <AramCentralQMQMIntf> prefix" "Value=true"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=QmRunLoop" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra logging that logs QM statistics every 25 seconds. These will show up with the <AramCentralQM::runLoop()> prefix" "Value=true"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=QmUpdateMessages" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables (the default) logging for all QueueUpdate messages. These will show up with the <QueueUpdate:> prefix" "Value=true"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=RobotQmClientMgrFwdTrace" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables extra logging path for packets sent, received and validated. These will show up with the <AramQMClientMgrFwd> prefix" "Value=false"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigParam "Name=RobotQmUpdateMessages" "Parent=Extra Logging" "Priority=Expert" "Type=bool" "Desc=Enables (the default) logging for all QueueUpdate messages. These will show up with the <QueueUpdate:> prefix" "Value=true"   "Display=Checkbox" 
LogInfoStrip: CustomInfo: ConfigSection "Name=Feedback"
LogInfoStrip: CustomInfo: ConfigParam "Name=TurningRotVel" "Parent=Feedback" "Priority=Expert" "Type=int" "Desc=Minimum rotational velocity (in deg/sec) that triggers feedback from turning." "Value=30" "Min=0" 
LogInfoStrip: CustomInfo: ConfigParam "Name=DrivingTransVel" "Parent=Feedback" "Priority=Expert" "Type=int" "Desc=Minimum translational or lateral velocity (in mm/sec) that triggers feedback for driving." "Value=10" "Min=0" 
LogInfoStrip: CustomInfo: ConfigParam "Name=LogDebugInfo" "Parent=Feedback" "Priority=Expert" "Type=bool" "Desc=Log debug information regarding feedback actions." "Value=false"  
LogInfoStrip: CustomInfo: ConfigParam "Name=LogDebugVerboseInfo" "Parent=Feedback" "Priority=Expert" "Type=bool" "Desc=Log verbose, detailed information regarding feedback actions." "Value=false"  
